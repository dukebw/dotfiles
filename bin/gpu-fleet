#!/usr/bin/env python3
"""Summon the GPU fleet layer: one floating monitor per owned GPU container.

Zellij glue over `b10-gpu fleet` (the Kubernetes-authority fleet query — see
dotfiles ADR 0001). Each pane runs a GPU monitor in its container via
`kubectl exec`; no rexec/ssh plumbing is involved, so a GPU container is
monitorable the moment it is running.

Reconcile-by-respawn semantics (bind to a key, e.g. tmux-mode F):
  - fleet unchanged vs live panes -> toggle the floating layer (like `f`)
  - fleet changed                 -> kill all fleet panes, respawn with fresh
                                     adaptive layout
Adaptive layout: portrait-first grids use at most two columns; a full 18-pane
NVL72 rack is 2x9.

Runs inside a Zellij session. On failure it prints the remedy and waits for a
keypress (the launcher pane doubles as the error pane).
"""

import json
import os
import re
import subprocess
import sys

MARKER = "GPU_FLEET_PANE"  # embedded in each pane's command line for pgrep
PANE_VERSION = 5  # bump when existing panes must be respawned
MONITOR_COMMAND = """if command -v nvitop >/dev/null 2>&1; then
  exec nvitop
elif command -v uvx >/dev/null 2>&1; then
  exec uvx --from nvitop nvitop
elif command -v nvidia-smi >/dev/null 2>&1; then
  exec nvidia-smi -l 1
else
  echo 'gpu-fleet: container has no nvitop, uvx, or nvidia-smi' >&2
  exit 127
fi"""


def fail(msg: str) -> None:
    print(f"gpu-fleet: {msg}", file=sys.stderr)
    print("\npress any key to close", file=sys.stderr)
    try:
        subprocess.run(["sh", "-c", "read -n1 -s"], check=False)
    except Exception:
        pass
    sys.exit(1)


def fleet() -> dict:
    proc = subprocess.run(
        ["b10-gpu", "--json", "fleet"], capture_output=True, text=True
    )
    if proc.returncode != 0:
        fail(
            "fleet query failed:\n"
            + proc.stderr.strip()
            + "\n\nlikely fixes: `rcli select` (expired auth) or check kube context"
        )
    return json.loads(proc.stdout)


def pod_key(pod: dict) -> str:
    return f"v{PANE_VERSION}:{pod['namespace']}/{pod['name']}:{pod['container']}"


def live_pane_keys() -> set[str]:
    proc = subprocess.run(["pgrep", "-fl", MARKER], capture_output=True, text=True)
    keys = set()
    for line in proc.stdout.splitlines():
        m = re.search(rf"{MARKER}=(\S+)", line)
        if m:
            keys.add(m.group(1))
    return keys


def geometry(n: int) -> list[dict[str, str]]:
    if n == 1:
        return [dict(x="5%", y="5%", width="90%", height="85%")]
    columns = min(n, 2)
    rows = (n + columns - 1) // columns
    cell_width = 100 // columns
    cell_height = 100 // rows
    return [
        dict(
            x=f"{(i % columns) * cell_width}%",
            y=f"{(i // columns) * cell_height}%",
            width=f"{cell_width}%",
            height=f"{cell_height}%",
        )
        for i in range(n)
    ]


def short(pod: dict) -> str:
    name = pod["name"]
    model = pod.get("model")
    if model:
        return model
    # brendanduke-tp8-dev-pod-b200-0 -> tp8; brendanduke-dev-pod-b200-0 -> dev
    m = re.match(r"[^-]+-(.+?)-?(dev-)?pod", name)
    label = m.group(1).rstrip("-") if m else name
    return label or "dev"


def pane_command(data: dict, pod: dict, geo: dict[str, str]) -> list[str]:
    namespace = pod["namespace"]
    name = pod["name"]
    container = pod["container"]
    node = pod["node"]
    return [
        "zellij", "run",
        "--floating", "--close-on-exit",
        "--name", f"nvitop@{short(pod)} [{node.split('-')[-1]}]",
        "-x", geo["x"], "-y", geo["y"],
        "--width", geo["width"], "--height", geo["height"],
        "--",
        "env", f"{MARKER}={pod_key(pod)}", f"KUBECONFIG={data['kubeconfig']}",
        "kubectl", "exec", "-it", "-n", namespace, name, "-c", container,
        "--", "sh", "-lc", MONITOR_COMMAND,
    ]


def main() -> None:
    if not os.environ.get("ZELLIJ"):
        sys.exit("gpu-fleet must run inside a Zellij session")
    data = fleet()
    pods = data["pods"]
    if not pods:
        fail(
            f"no running GPU containers owned by {data['owner']!r} in "
            f"{', '.join(data['namespaces'])}"
        )

    if {pod_key(pod) for pod in pods} == live_pane_keys():
        subprocess.run(["zellij", "action", "toggle-floating-panes"], check=False)
        return

    subprocess.run(["pkill", "-f", MARKER], check=False)  # panes close via close-on-exit

    for pod, geo in zip(pods, geometry(len(pods))):
        cmd = pane_command(data, pod, geo)
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            fail(f"zellij run failed for {pod_key(pod)}:\n{proc.stderr.strip()}")


if __name__ == "__main__":
    main()
