#!/usr/bin/env bash
set -euo pipefail

mode="clean"
allow_diagnostics=0
probe_local_guard=0
probe_tunnel_recovery=0
definition_position=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --inject) mode="injected"; shift ;;
    --allow-diagnostics) allow_diagnostics=1; shift ;;
    --probe-local-guard) probe_local_guard=1; shift ;;
    --probe-tunnel-recovery) probe_tunnel_recovery=1; shift ;;
    --definition) definition_position="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done

file="${1:-}"
if [[ -z "$file" ]]; then
  printf 'usage: check-remote-clangd-nvim [--inject] [--allow-diagnostics] [--probe-local-guard] [--probe-tunnel-recovery] [--definition LINE:COLUMN] PATH\n' >&2
  exit 2
fi

REMOTE_CLANGD_TEST_MODE="$mode" REMOTE_CLANGD_ALLOW_DIAGNOSTICS="$allow_diagnostics" REMOTE_CLANGD_PROBE_LOCAL_GUARD="$probe_local_guard" REMOTE_CLANGD_PROBE_TUNNEL_RECOVERY="$probe_tunnel_recovery" REMOTE_CLANGD_DEFINITION_POSITION="$definition_position" nvim --headless -n "$file" +'lua
local bufnr = vim.api.nvim_get_current_buf()
local mode = vim.env.REMOTE_CLANGD_TEST_MODE or "clean"
local expect_diagnostics = mode == "injected"
local allow_diagnostics = vim.env.REMOTE_CLANGD_ALLOW_DIAGNOSTICS == "1"
local probe_local_guard = vim.env.REMOTE_CLANGD_PROBE_LOCAL_GUARD == "1"
local probe_tunnel_recovery = vim.env.REMOTE_CLANGD_PROBE_TUNNEL_RECOVERY == "1"
local definition_position = vim.env.REMOTE_CLANGD_DEFINITION_POSITION or ""

local function out(message)
  io.stdout:write(message .. "\n")
  io.stdout:flush()
end

local function fail(message)
  io.stderr:write(message .. "\n")
  vim.cmd "cquit"
end

if expect_diagnostics then
  local line_count = vim.api.nvim_buf_line_count(bufnr)
  vim.api.nvim_buf_set_lines(bufnr, line_count, line_count, false, {
    "",
    "__global__ void __remote_clangd_probe() {",
    "  definitely_not_declared_for_remote_clangd_probe = 1;",
    "}",
  })
end

local attached = vim.wait(60000, function()
  for _, client in ipairs(vim.lsp.get_clients { bufnr = bufnr }) do
    if client.name:match "^remote_clangd_" then
      return true
    end
  end
  return false
end, 100)

if not attached then
  local names = {}
  for _, client in ipairs(vim.lsp.get_clients { bufnr = bufnr }) do
    table.insert(names, client.name)
  end
  fail("remote clangd did not attach. attached clients: " .. table.concat(names, ", "))
end

if probe_tunnel_recovery then
  local original_client
  for _, client in ipairs(vim.lsp.get_clients { bufnr = bufnr }) do
    if client.name:match "^remote_clangd_" then
      original_client = client
      break
    end
  end

  vim.wait(6000, function()
    return false
  end, 100)
  local cmd = original_client.config.cmd or {}
  local ssh_alias
  for i, arg in ipairs(cmd) do
    if arg == "--ssh-alias" then
      ssh_alias = cmd[i + 1]
      break
    end
  end
  if not ssh_alias then
    fail "remote clangd command has no SSH alias"
  end
  local ssh_config = vim.system({ "ssh", "-G", ssh_alias }, { text = true }):wait()
  local ssh_port = ssh_config.stdout
    and (ssh_config.stdout:match "^port%s+(%d+)" or ssh_config.stdout:match "\nport%s+(%d+)")
  if not ssh_port then
    fail "could not resolve remote clangd SSH port"
  end
  local lsof_result = vim.system(
    { "lsof", "-nP", "-iTCP:" .. ssh_port, "-sTCP:LISTEN", "-t" },
    { text = true }
  ):wait()
  local tunnel_pid = lsof_result.stdout and lsof_result.stdout:match "%d+"
  if not tunnel_pid then
    fail "could not find rexec port-forward process"
  end
  local kill_result = vim.system({ "kill", tunnel_pid }, { text = true }):wait()
  if kill_result.code ~= 0 then
    fail "failed to stop rexec port-forward process"
  end

  local recovered = vim.wait(90000, function()
    for _, client in ipairs(vim.lsp.get_clients { bufnr = bufnr }) do
      if client.name:match "^remote_clangd_" and client.id ~= original_client.id and client.initialized then
        return true
      end
    end
    return false
  end, 100)
  if not recovered then
    fail "remote clangd did not recover after tunnel loss"
  end
  out "tunnel recovery: passed"
end

if probe_local_guard then
  local saw_local_attach = false
  vim.api.nvim_create_autocmd("LspAttach", {
    once = true,
    callback = function(args)
      local client = vim.lsp.get_client_by_id(args.data.client_id)
      saw_local_attach = client ~= nil and client.name == "clangd"
    end,
  })
  local local_client_id = vim.lsp.start({
    name = "clangd",
    cmd = { "/usr/bin/clangd" },
    root_dir = vim.fs.root(bufnr, { ".clangd", ".git" }),
  }, { bufnr = bufnr })
  if not local_client_id then
    fail "failed to start local clangd guard probe"
  end

  local guarded = vim.wait(30000, function()
    if not saw_local_attach then
      return false
    end
    return #vim.lsp.get_clients { bufnr = bufnr, name = "clangd" } == 0
  end, 100)
  local local_client = vim.lsp.get_client_by_id(local_client_id)
  if local_client then
    local_client:stop()
  end
  if not guarded then
    fail "local clangd attached to a remote-managed buffer"
  end
  out "local clangd guard: passed"
end

local names = {}
for _, client in ipairs(vim.lsp.get_clients { bufnr = bufnr }) do
  table.insert(names, client.name)
  if client.name == "clangd" then
    fail "local clangd attached; expected remote clangd"
  end
end

out("attached clients: " .. table.concat(names, ", "))
out("mode: " .. mode)

local responses = vim.lsp.buf_request_sync(bufnr, "textDocument/documentSymbol", {
  textDocument = { uri = vim.uri_from_bufnr(bufnr) },
}, 30000)

if not responses then
  fail "remote clangd did not answer documentSymbol"
end

if definition_position ~= "" then
  local line, column = definition_position:match "^(%d+):(%d+)$"
  line, column = tonumber(line), tonumber(column)
  if not line or not column or line < 1 or column < 1 then
    fail "definition position must be LINE:COLUMN with one-based values"
  end

  local definition_responses = vim.lsp.buf_request_sync(bufnr, "textDocument/definition", {
    textDocument = { uri = vim.uri_from_bufnr(bufnr) },
    position = { line = line - 1, character = column - 1 },
  }, 30000)
  if not definition_responses then
    fail "remote clangd did not answer definition"
  end

  local definition_found = false
  for client_id, response in pairs(definition_responses) do
    local result = response.result
    if result and not vim.tbl_isempty(result) then
      local locations = vim.islist(result) and result or { result }
      for _, location in ipairs(locations) do
        local uri = location.uri or location.targetUri
        local range = location.range or location.targetSelectionRange or location.targetRange
        if uri and range then
          local filename = vim.uri_to_fname(uri)
          if vim.fn.filereadable(filename) ~= 1 then
            fail("definition target is not readable locally: " .. filename)
          end
          local target_line = range.start.line + 1
          if #vim.fn.readfile(filename, "", target_line) < target_line then
            fail(string.format("definition target line %d is outside %s", target_line, filename))
          end
          local client = vim.lsp.get_client_by_id(client_id)
          local shown, show_error = pcall(
            vim.lsp.util.show_document,
            location,
            client and client.offset_encoding or "utf-16",
            { reuse_win = true }
          )
          if not shown then
            fail("show_document failed: " .. tostring(show_error))
          end
          if vim.api.nvim_win_get_cursor(0)[1] ~= target_line then
            fail(string.format("definition jump did not reach line %d in %s", target_line, filename))
          end
          out(string.format("definition: %s:%d", filename, target_line))
          definition_found = true
          break
        end
      end
    end
    if definition_found then
      break
    end
  end
  if not definition_found then
    fail "remote clangd returned no definition"
  end
end

if expect_diagnostics then
  vim.wait(30000, function()
    return #vim.diagnostic.get(bufnr) > 0
  end, 100)
else
  vim.wait(5000, function()
    return false
  end, 100)
end

local diagnostics = vim.diagnostic.get(bufnr)
local diagnostic_namespaces = vim.diagnostic.get_namespaces()
out("diagnostics: " .. tostring(#diagnostics))

for _, diagnostic in ipairs(diagnostics) do
  out(string.format("%d:%d %s", diagnostic.lnum + 1, diagnostic.col + 1, diagnostic.message:gsub("\n", " ")))
end

for _, diagnostic in ipairs(diagnostics) do
  local namespace = diagnostic_namespaces[diagnostic.namespace]
  if namespace and namespace.name:match "^nvim%.lsp%.clangd%." then
    fail "saw stale local clangd diagnostic"
  end
  if diagnostic.message:find("sm_52", 1, true)
    or diagnostic.message:find("Cannot find CUDA installation", 1, true)
    or diagnostic.message:find("Cannot find libdevice", 1, true)
    or diagnostic.message:find("file not found", 1, true)
    or diagnostic.message:find("No such file or directory", 1, true)
  then
    fail "saw clangd toolchain setup diagnostic"
  end
end

if expect_diagnostics and #diagnostics == 0 then
  fail "expected injected remote clangd diagnostic, got none"
end

if not expect_diagnostics and not allow_diagnostics and #diagnostics > 0 then
  fail "expected clean remote clangd diagnostics, got diagnostics"
end

vim.cmd "quitall!"
'
