#!/usr/bin/env bash
set -euo pipefail

local_root=""
remote_root=""
ssh_alias=""
remote_clangd="clangd-21"
remote_compiler="clang++-21"
cuda_arch="sm_100a"
cuda_path="/usr/local/cuda"
compile_commands_dir=""
generate_fallback_compile_commands=0
container=""
cmake_source_dir=""
cmake_args=()
cmake_env=()
mirror_build_paths=()

usage() {
  printf 'usage: remote-clangd --local-root PATH --remote-root PATH --ssh-alias ALIAS [--compile-commands-dir PATH] [--cmake-source-dir PATH] [--cmake-arg ARG] [--cmake-env KEY=VALUE] [--mirror-build-path PATH] [--container NAME] [options]\n' >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --local-root) local_root="${2:-}"; shift 2 ;;
    --remote-root) remote_root="${2:-}"; shift 2 ;;
    --ssh-alias) ssh_alias="${2:-}"; shift 2 ;;
    --clangd) remote_clangd="${2:-}"; shift 2 ;;
    --compiler) remote_compiler="${2:-}"; shift 2 ;;
    --cuda-arch) cuda_arch="${2:-}"; shift 2 ;;
    --cuda-path) cuda_path="${2:-}"; shift 2 ;;
    --compile-commands-dir) compile_commands_dir="${2:-}"; shift 2 ;;
    --cmake-source-dir) cmake_source_dir="${2:-}"; shift 2 ;;
    --cmake-arg) cmake_args+=("${2:-}"); shift 2 ;;
    --cmake-env) cmake_env+=("${2:-}"); shift 2 ;;
    --mirror-build-path) mirror_build_paths+=("${2:-}"); shift 2 ;;
    --container) container="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n "$local_root" && -n "$remote_root" && -n "$ssh_alias" ]] || usage

cache_key="$(printf '%s' "$remote_root" | shasum | cut -d' ' -f1)"
if [[ -z "$compile_commands_dir" ]]; then
  compile_commands_dir="/tmp/remote-clangd/$cache_key"
  if [[ -z "$cmake_source_dir" ]]; then
    generate_fallback_compile_commands=1
  fi
fi

if [[ -n "$container" && "$generate_fallback_compile_commands" == 1 ]]; then
  printf 'remote-clangd: --container requires --compile-commands-dir\n' >&2
  exit 2
fi

if [[ -n "$container" && -n "$cmake_source_dir" ]]; then
  printf 'remote-clangd: CMake configuration inside --container is not supported\n' >&2
  exit 2
fi

if [[ "${#mirror_build_paths[@]}" -gt 0 && -z "$cmake_source_dir" ]]; then
  printf 'remote-clangd: --mirror-build-path requires --cmake-source-dir\n' >&2
  exit 2
fi

for mirror_path in "${mirror_build_paths[@]}"; do
  if [[ -z "$mirror_path" || "$mirror_path" == /* || "$mirror_path" == ".." || "$mirror_path" == ../* || "$mirror_path" == */../* || "$mirror_path" == */.. ]]; then
    printf 'remote-clangd: mirror path must stay within the CMake build directory: %s\n' "$mirror_path" >&2
    exit 2
  fi
done

quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\''/g")"
}

cmake_command=""
cmake_fingerprint=""
if [[ -n "$cmake_source_dir" ]]; then
  local_cmake_source_dir="$cmake_source_dir"
  remote_cmake_source_dir="$cmake_source_dir"
  if [[ "$cmake_source_dir" != /* ]]; then
    local_cmake_source_dir="$local_root/$cmake_source_dir"
    remote_cmake_source_dir="$remote_root/$cmake_source_dir"
  elif [[ "$cmake_source_dir" == "$remote_root"/* ]]; then
    local_cmake_source_dir="$local_root${cmake_source_dir#"$remote_root"}"
  else
    printf 'remote-clangd: absolute CMake source must be under the remote root: %s\n' "$cmake_source_dir" >&2
    exit 2
  fi

  cmake_command="env"
  for assignment in "${cmake_env[@]}"; do
    if [[ ! "$assignment" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      printf 'remote-clangd: invalid CMake environment assignment: %s\n' "$assignment" >&2
      exit 2
    fi
    cmake_command+=" $(quote "$assignment")"
  done
  cmake_command+=" cmake -S $(quote "$remote_cmake_source_dir") -B $(quote "$compile_commands_dir")"
  for arg in "${cmake_args[@]}"; do
    cmake_command+=" $(quote "$arg")"
  done

  cmake_fingerprint="$(python3 - "$local_cmake_source_dir" "$cmake_command" <<'PY'
import hashlib
import os
import sys

root, seed = sys.argv[1:]
digest = hashlib.sha256(seed.encode())
source_extensions = {'.c', '.cc', '.cpp', '.cu', '.cuh', '.cxx', '.h', '.hh', '.hpp', '.hxx'}
skip_dirs = {'.cache', '.git', '.mypy_cache', '.pytest_cache', '.ruff_cache', '.venv', '__pycache__'}

for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = sorted(
        name for name in dirnames
        if name not in skip_dirs and name != 'build' and not name.startswith('build_')
    )
    for filename in sorted(filenames):
        path = os.path.join(dirpath, filename)
        relative_path = os.path.relpath(path, root)
        extension = os.path.splitext(filename)[1].lower()
        if filename == 'CMakeLists.txt' or extension == '.cmake':
            digest.update(relative_path.encode())
            with open(path, 'rb') as source:
                digest.update(source.read())
        elif extension in source_extensions:
            digest.update(relative_path.encode())

print(digest.hexdigest())
PY
)"
fi

remote_prepare_cmd="set -euo pipefail
cd $(quote "$remote_root")
if [[ -n $(quote "$cmake_source_dir") ]]; then
  mkdir -p $(quote "$compile_commands_dir")
  exec 9>$(quote "$compile_commands_dir/.remote-clangd-configure.lock")
  flock 9
  previous_fingerprint=''
  if [[ -f $(quote "$compile_commands_dir/.remote-clangd-cmake-fingerprint") ]]; then
    previous_fingerprint=\$(<$(quote "$compile_commands_dir/.remote-clangd-cmake-fingerprint"))
  fi
  if [[ ! -f $(quote "$compile_commands_dir/compile_commands.json") || \"\$previous_fingerprint\" != $(quote "$cmake_fingerprint") ]]; then
    printf 'remote-clangd: configuring CMake compilation database: %s\n' $(quote "$compile_commands_dir/compile_commands.json") >&2
    $cmake_command >&2
    if [[ ! -f $(quote "$compile_commands_dir/compile_commands.json") ]]; then
      printf 'remote-clangd: CMake did not produce a compilation database: %s\n' $(quote "$compile_commands_dir/compile_commands.json") >&2
      exit 1
    fi
    printf '%s\n' $(quote "$cmake_fingerprint") >$(quote "$compile_commands_dir/.remote-clangd-cmake-fingerprint")
  fi
elif [[ $(quote "$generate_fallback_compile_commands") == 1 || ! -f $(quote "$compile_commands_dir/compile_commands.json") ]]; then
  if [[ $(quote "$generate_fallback_compile_commands") == 0 ]]; then
    printf 'remote-clangd: compilation database not found; generating fallback: %s\n' $(quote "$compile_commands_dir/compile_commands.json") >&2
  fi
  mkdir -p $(quote "$compile_commands_dir")
  python3 - $(quote "$remote_root") $(quote "$compile_commands_dir") $(quote "$remote_compiler") $(quote "$cuda_path") $(quote "$cuda_arch") <<'PY'
import json
import os
import sys

root, build_dir, compiler, cuda_path, cuda_arch = sys.argv[1:]
skip_dirs = {
    '.git',
    '.cache',
    '.mypy_cache',
    '.pytest_cache',
    '.ruff_cache',
    '.venv',
    '__pycache__',
    'node_modules',
    'venv',
}
source_languages = {
    '.c': ('c', 'c17'),
    '.cc': ('c++', 'c++17'),
    '.cpp': ('c++', 'c++17'),
    '.cu': ('cuda', 'c++17'),
    '.cuh': ('cuda', 'c++17'),
    '.cxx': ('c++', 'c++17'),
    '.h': ('c++-header', 'c++17'),
    '.hh': ('c++-header', 'c++17'),
    '.hpp': ('c++-header', 'c++17'),
    '.hxx': ('c++-header', 'c++17'),
}
include_dirs = [
    root,
    os.path.join(root, 'cpp'),
    os.path.join(root, 'cpp', 'include'),
    os.path.join(root, '3rdparty', 'cutlass', 'include'),
    os.path.join(cuda_path, 'include'),
    '/usr/local/tensorrt/include',
]
include_args = [arg for path in include_dirs for arg in ('-I', path)]
entries = []

for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = [
        name for name in dirnames
        if name not in skip_dirs and not name.startswith('.mutagen')
    ]

    for filename in filenames:
        language = source_languages.get(os.path.splitext(filename)[1].lower())
        if language is None:
            continue

        path = os.path.join(dirpath, filename)
        language_name, standard = language
        arguments = [
            compiler,
            '-x', language_name,
            *include_args,
            '-std=' + standard,
            '-fPIC',
        ]
        if language_name == 'cuda':
            arguments.extend([
                '--cuda-path=' + cuda_path,
                '--no-cuda-version-check',
                '--cuda-gpu-arch=' + cuda_arch,
            ])
        arguments.extend(['-c', path])
        entries.append({
            'directory': dirpath,
            'file': path,
            'arguments': arguments,
        })

output_path = os.path.join(build_dir, 'compile_commands.json')
temporary_path = output_path + f'.{os.getpid()}.tmp'
with open(temporary_path, 'w', encoding='utf-8') as f:
    json.dump(entries, f, indent=2)
os.replace(temporary_path, output_path)
PY
fi
"

remote_run_cmd="set -euo pipefail
cd $(quote "$remote_root")
if [[ -n $(quote "$container") ]]; then
  exec docker exec -i $(quote "$container") $(quote "$remote_clangd") --compile-commands-dir=$(quote "$compile_commands_dir") --path-mappings=$(quote "$local_root=$remote_root")
fi
exec $(quote "$remote_clangd") --compile-commands-dir=$(quote "$compile_commands_dir") --path-mappings=$(quote "$local_root=$remote_root")
"

ssh_options=(
  -T
  -o BatchMode=yes
  -o ConnectTimeout=5
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=2
  -o LogLevel=ERROR
)
ssh_control_cmd=(ssh -n "${ssh_options[@]}" "$ssh_alias")
ssh_lsp_cmd=(ssh "${ssh_options[@]}" "$ssh_alias")

prepare_status=0
"${ssh_control_cmd[@]}" "$remote_prepare_cmd" >&2 || prepare_status=$?
if [[ "$prepare_status" -eq 255 ]]; then
  exit 0
fi
if [[ "$prepare_status" -ne 0 ]]; then
  exit "$prepare_status"
fi

if [[ "${#mirror_build_paths[@]}" -gt 0 ]]; then
  mirror_marker="$compile_commands_dir/.remote-clangd-mirror-fingerprint"
  previous_mirror_fingerprint=""
  if [[ -f "$mirror_marker" ]]; then
    previous_mirror_fingerprint="$(<"$mirror_marker")"
  fi

  mirror_needed=0
  if [[ "$previous_mirror_fingerprint" != "$cmake_fingerprint" ]]; then
    mirror_needed=1
  fi
  for mirror_path in "${mirror_build_paths[@]}"; do
    if [[ ! -e "$compile_commands_dir/$mirror_path" ]]; then
      mirror_needed=1
    fi
  done

  if [[ "$mirror_needed" -eq 1 ]]; then
    mkdir -p "$compile_commands_dir"
    for mirror_path in "${mirror_build_paths[@]}"; do
      if ! "${ssh_control_cmd[@]}" "tar -C $(quote "$compile_commands_dir") -cf - -- $(quote "$mirror_path")" | tar -C "$compile_commands_dir" -xf -; then
        printf 'remote-clangd: failed to mirror build path: %s\n' "$mirror_path" >&2
        exit 1
      fi
    done
    printf '%s\n' "$cmake_fingerprint" >"$mirror_marker"
  fi
fi

status=0
"${ssh_lsp_cmd[@]}" "$remote_run_cmd" || status=$?

if [[ "$status" -eq 255 ]]; then
  exit 0
fi
exit "$status"
