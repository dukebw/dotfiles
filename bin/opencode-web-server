#!/bin/zsh

set -euo pipefail
umask 077

readonly repo_dir="${OPENCODE_WEB_DIRECTORY:-$HOME/work/baseten}"
readonly log_dir="$HOME/Library/Logs"

mkdir -p "$log_dir"
exec >>"$log_dir/opencode-web.log" 2>>"$log_dir/opencode-web.error.log"

cd "$repo_dir"

opencode_bin="$(command -v opencode)" || {
  print -u2 "opencode is not available on the login shell PATH"
  exit 1
}
readonly opencode_bin

export OPENCODE_DISABLE_FFF=1
export OPENCODE_SERVER_PASSWORD
OPENCODE_SERVER_PASSWORD=$(
  /usr/bin/security find-generic-password \
    -a "opencode-server" \
    -s "ai.opencode.web" \
    -w
)

exec /usr/bin/caffeinate -i \
  "$opencode_bin" web \
  --hostname 127.0.0.1 \
  --port 4096
