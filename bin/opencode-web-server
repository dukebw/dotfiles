#!/bin/zsh

set -euo pipefail
umask 077

readonly repo_dir="${OPENCODE_WEB_DIRECTORY:-$HOME/work/baseten}"
readonly log_dir="$HOME/Library/Logs"

mkdir -p "$log_dir"
exec >>"$log_dir/opencode-web.log" 2>>"$log_dir/opencode-web.error.log"

cd "$repo_dir"

readonly opencode_bin="$HOME/.local/bin/opencode"
[[ -x "$opencode_bin" ]] || {
  print -u2 "opencode is not installed at $opencode_bin"
  exit 1
}

export OPENCODE_DISABLE_FFF=1
export OPENCODE_DISABLE_AUTOUPDATE=1

[[ "$("$opencode_bin" service get hostname)" == "127.0.0.1" &&
   "$("$opencode_bin" service get port)" == "4096" ]] || {
  print -u2 "Configure the OpenCode service hostname as 127.0.0.1 and port as 4096"
  exit 1
}

/usr/bin/caffeinate -i -w $$ &
while true; do
  "$opencode_bin" service start >/dev/null
  sleep 30
done
