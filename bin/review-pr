#!/usr/bin/env python3
"""Open a GitHub review and its source diff in a Zellij tab."""

import argparse
import contextlib
import fcntl
import hashlib
import io
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
import zipfile


PROJECT = Path("mp/baseten_dynamo/cache_aware_routing_trtllm")
STACK_PATHS = (PROJECT / "docker/sglang/patches", PROJECT / "versions/sglang.env")
FLASHINFER_PATHS = (
    PROJECT / "docker/flashinfer",
    PROJECT / "docker/flashinfer_nvfp4_adapter.patch",
    PROJECT / "docker/gpu.sglang.Dockerfile",
)
BASE_REF = "refs/pr-review/base"
HEAD_REF = "refs/pr-review/head"
APPLIED_REFS = "refs/applied/"
REVIEW_MODEL = "openai/gpt-6-astra#xhigh"


def run(*args, cwd=None, env=None, input=None):
    result = subprocess.run(
        [str(arg) for arg in args],
        cwd=cwd,
        env=env,
        input=input,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode:
        raise RuntimeError(
            f"{shlex.join(str(arg) for arg in args)} failed:\n"
            f"{result.stdout}{result.stderr}"
        )
    return result.stdout


def git(directory, *args, input=None):
    return run("git", "-C", directory, *args, input=input).strip()


@contextlib.contextmanager
def step(message):
    started = time.monotonic()
    print(f"{message}...", flush=True)
    yield
    print(f"{message}: done ({time.monotonic() - started:.1f}s)", flush=True)


def require_clean(directory, expected_head):
    if git(directory, "status", "--porcelain"):
        raise RuntimeError(
            f"Preserve local changes in {directory} before reopening this review"
        )
    if git(directory, "rev-parse", "HEAD") != expected_head:
        raise RuntimeError(
            f"HEAD changed in {directory}; preserve that work before refreshing the review"
        )


def save_state(path, state):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    temporary.replace(path)


def prepare_worktree(checkout, destination, repo, head):
    if destination.exists():
        metadata = (
            Path(git(destination, "rev-parse", "--absolute-git-dir")) / "pr-review"
        )
        state_path = metadata / "state.json"
        if not state_path.exists():
            raise RuntimeError(
                f"{destination} already exists and was not created by review-pr"
            )
        state = json.loads(state_path.read_text())
        if state["repo"] != repo:
            raise RuntimeError(f"{destination} belongs to {state['repo']}, not {repo}")
        require_clean(destination, state["head"])
    else:
        git(checkout, "worktree", "add", "--detach", destination, head)
        metadata = (
            Path(git(destination, "rev-parse", "--absolute-git-dir")) / "pr-review"
        )
        metadata.mkdir()
        state_path = metadata / "state.json"
        state = {"repo": repo, "head": head}
        save_state(state_path, state)
    return state_path, state


def snapshot(checkout, revision, destination):
    result = subprocess.run(
        [
            "git",
            "-C",
            str(checkout),
            "archive",
            revision,
            *(str(p) for p in STACK_PATHS),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode:
        raise RuntimeError(
            f"Cannot read SGLang stack at {revision}: {result.stderr.decode()}"
        )
    with tarfile.open(fileobj=io.BytesIO(result.stdout)) as contents:
        contents.extractall(destination, filter="data")
    project = destination / PROJECT
    pin = re.search(
        r"^ENGINE_SHA=(\S+)$", (project / "versions/sglang.env").read_text(), re.M
    )
    if pin is None or not re.fullmatch(r"[0-9a-f]{7,40}|v[0-9][\w.-]*", pin[1]):
        raise RuntimeError(
            f"Expected an SGLang release tag or commit in {revision}:versions/sglang.env"
        )
    return project, pin[1]


def cache_pin(cache, pin):
    if not cache.exists():
        run("git", "init", "--bare", cache)
        git(
            cache,
            "remote",
            "add",
            "origin",
            "https://github.com/sgl-project/sglang.git",
        )
    if git(cache, "rev-parse", "--is-bare-repository") != "true":
        raise RuntimeError(f"Expected a bare SGLang cache at {cache}")
    found = subprocess.run(
        [
            "git",
            "-C",
            str(cache),
            "rev-parse",
            "--verify",
            "--quiet",
            f"{pin}^{{commit}}",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if found.returncode:
        with step(f"Fetching SGLang {pin}"):
            git(cache, "fetch", "--depth=1", "origin", pin)
            commit = git(cache, "rev-parse", "FETCH_HEAD^{commit}")
            git(cache, "update-ref", f"refs/heads/pins/{commit}", commit)
            if pin.startswith("v"):
                git(cache, "update-ref", f"refs/tags/{pin}", commit)


def init_source(helper, project, source, cache, pin, patches):
    # Each ref names the source after one patch: the pinned commit and every patch so
    # far. A replay starts from the longest run of leading patches applied before.
    base = git(cache, "rev-parse", "--verify", f"{pin}^{{commit}}")
    digest, refs = hashlib.sha256(base.encode()), []
    for path in patches:
        digest.update(
            path.name.encode() + b"\0" + hashlib.sha256(path.read_bytes()).digest()
        )
        refs.append(f"{APPLIED_REFS}{digest.hexdigest()}")
    applied = set(
        git(cache, "for-each-ref", "--format=%(refname)", APPLIED_REFS).split()
    )
    reused = next(
        (count for count in range(len(refs), 0, -1) if refs[count - 1] in applied), 0
    )
    print(f"Reusing {reused} of {len(refs)} applied SGLang patches", flush=True)
    # Mirror the helper's init_sglang through patch_stack primitives loaded from the
    # installed checkout (never the PR's code), skipping description() validation:
    # headers gate patch export, not the application of a historical stack under review.
    run(
        sys.executable,
        "-B",
        "-c",
        "import dataclasses,importlib,os,runpy,subprocess,sys\n"
        "from pathlib import Path\n"
        "entrypoint = Path(sys.argv.pop(1))\n"
        "sys.path.insert(0, str(entrypoint.parent))\n"
        "helper = runpy.run_path(str(entrypoint))\n"
        "ps = importlib.import_module('patch_stack')\n"
        "project = dataclasses.replace(helper['PROJECT'], root=Path(sys.argv.pop(1)))\n"
        "base, start, reused = sys.argv[1], sys.argv[2], int(sys.argv[3])\n"
        "source = Path(os.environ[project.source_env])\n"
        "stack = [(p, p.read_text().split('diff --git ', 1)[0].strip())\n"
        "         for p in ps.patches(project.patch_dir)]\n"
        "clone = source.with_name(source.name + '.tmp')\n"
        "subprocess.run(['git', 'clone', '--no-checkout', '--', project.git_url,\n"
        "                str(clone)], check=True)\n"
        "if reused:\n"
        "    ps.git(clone, 'fetch', '--no-tags', '--update-shallow', 'origin', start,\n"
        "           capture=False)\n"
        "    start = 'FETCH_HEAD'\n"
        "ps.git(clone, 'checkout', '-b', 'baseten-patches', start, capture=False)\n"
        "ps.apply_stack(clone, stack[reused:])\n"
        "ps.save(project, clone, dict(base=base, version=project.pin(),\n"
        "    exported=ps.git(clone, 'rev-parse', 'HEAD').strip(),\n"
        "    fingerprint=ps.fingerprint(project)))\n"
        "clone.rename(source)\n",
        helper,
        project,
        base,
        refs[reused - 1] if reused else base,
        reused,
        env={
            **os.environ,
            "SGLANG_SOURCE_DIR": str(source),
            "SGLANG_GIT_URL": str(cache),
            # Global hooks (secret scan, LFS) cost about a second per replayed patch.
            "GIT_CONFIG_COUNT": "1",
            "GIT_CONFIG_KEY_0": "core.hooksPath",
            "GIT_CONFIG_VALUE_0": "/dev/null",
        },
    )
    commits = git(source, "rev-list", "--reverse", f"{base}..HEAD").split()
    if len(commits) != len(refs):
        raise RuntimeError(
            f"Expected {len(refs)} patch commits in {source}, found {len(commits)}"
        )
    if reused < len(refs):
        git(cache, "fetch", "--no-tags", "--update-shallow", source, "HEAD")
        git(
            cache,
            "update-ref",
            "--stdin",
            input="".join(
                f"create {ref} {commit}\n"
                for ref, commit in zip(refs[reused:], commits[reused:])
            ),
        )
        git(cache, "pack-refs", "--all")


def normalize_legacy_stack(directory):
    if (directory / "series").exists():
        return
    paths = sorted(directory.glob("*.patch"))
    indices = {}
    for path in paths:
        match = re.fullmatch(r"(\d{3})_[a-z][a-z0-9_]*\.patch", path.name)
        if match is None:
            raise ValueError(
                f"Missing series manifest for non-numbered patch: {path.name}"
            )
        index = match[1]
        if index in indices:
            raise ValueError(
                f"Duplicate patch ordering index {index}: {indices[index]}, {path.name}"
            )
        indices[index] = path.name
    # Only archived snapshots are adapted; retain historical order and distinct names.
    names = []
    for path in paths:
        name = f"legacy_{path.name}"
        path.rename(directory / name)
        names.append(name)
    (directory / "series").write_text("".join(f"{name}\n" for name in names))


def publish_source(base_source, head_source, source):
    source_head = git(head_source, "rev-parse", "HEAD")
    git(
        head_source,
        "fetch",
        "--no-tags",
        "--update-shallow",
        base_source,
        f"HEAD:{BASE_REF}",
    )
    git(head_source, "update-ref", HEAD_REF, source_head)
    if source.exists():
        git(
            source,
            "fetch",
            "--no-tags",
            "--update-shallow",
            head_source,
            f"+{BASE_REF}:{BASE_REF}",
            f"+{HEAD_REF}:{HEAD_REF}",
        )
    else:
        source.parent.mkdir(parents=True, exist_ok=True)
        head_source.rename(source)
    git(source, "checkout", "--detach", HEAD_REF)
    return source_head


def prepare_sglang(checkout, worktree, baseline, head, state_path, state, cache):
    source = worktree / PROJECT / "sglang"
    if source.exists():
        if "source_head" not in state:
            raise RuntimeError(
                f"{source} already exists and was not created by review-pr"
            )
        require_clean(source, state["source_head"])
        if state.get("source_revisions") == [baseline, head]:
            return source
    helper = checkout / PROJECT / "bin/sglang_dev.py"
    with step("Applying baseline and proposed SGLang stacks"):
        with tempfile.TemporaryDirectory(
            prefix="sglang-", dir=state_path.parent
        ) as temporary:
            scratch = Path(temporary)
            before, old_pin = snapshot(checkout, baseline, scratch / "base")
            after, new_pin = snapshot(checkout, head, scratch / "head")
            validate_patches = runpy.run_path(str(helper.parent / "patch_stack.py"))[
                "patches"
            ]
            stacks = []
            for label, project in (("Baseline", before), ("Proposed", after)):
                try:
                    directory = project / "docker/sglang/patches"
                    normalize_legacy_stack(directory)
                    stacks.append(validate_patches(directory))
                except (ValueError, OSError) as exc:
                    raise RuntimeError(
                        f"{label} SGLang patch stack is invalid: {exc}"
                    ) from None
            cache_pin(cache, old_pin)
            cache_pin(cache, new_pin)
            print(f"SGLang source comparison: {old_pin} → {new_pin}", flush=True)
            base_source, head_source = scratch / "base-source", scratch / "head-source"
            init_source(helper, before, base_source, cache, old_pin, stacks[0])
            init_source(helper, after, head_source, cache, new_pin, stacks[1])
            source_head = publish_source(base_source, head_source, source)
            state.update(source_head=source_head, source_revisions=[baseline, head])
            save_state(state_path, state)
    return source


def flashinfer_stack(checkout, revision):
    dockerfile = git(
        checkout, "show", f"{revision}:{PROJECT}/docker/gpu.sglang.Dockerfile"
    )
    versions = set(
        re.findall(r"""flashinfer\.__version__\s*==\s*["']([\w.+-]+)["']""", dockerfile)
    )
    if len(versions) != 1:
        raise RuntimeError(
            f"Expected one FlashInfer version assertion in {revision}:gpu.sglang.Dockerfile"
        )
    copied = {}
    applied = set()
    patches = []
    for line in dockerfile.replace("\\\n", " ").splitlines():
        if line.startswith("COPY "):
            words = shlex.split(line)
            if len(words) == 3 and words[1].endswith(".patch"):
                path = Path(words[1])
                if str(path).startswith("docker/flashinfer"):
                    if ".." in path.parts or path.is_absolute():
                        raise RuntimeError(f"Invalid FlashInfer patch path: {path}")
                    target = words[2]
                    if target.endswith("/"):
                        target += path.name
                    copied[target] = path
        elif line.startswith("RUN "):
            lexer = shlex.shlex(line[4:], posix=True, punctuation_chars=";&|")
            lexer.whitespace_split = True
            pending = []
            for word in [*lexer, ";"]:
                if word not in (";", "&&", "||", "|", "&"):
                    pending.append(word)
                    continue
                words, pending = pending, []
                if words[:1] != ["patch"]:
                    continue
                if not any("flashinfer_dir" in word for word in words):
                    continue
                inputs = [
                    word.removeprefix("--input=")
                    for word in words
                    if word.startswith("--input=")
                ]
                required = {"--forward", "--batch", "--fuzz=0", "-p1"}
                if (
                    not required.issubset(words)
                    or "-d" not in words
                    or words[words.index("-d") + 1 : words.index("-d") + 2]
                    != ["$flashinfer_dir"]
                    or len(inputs) != 1
                    or inputs[0] not in copied
                ):
                    raise RuntimeError(
                        f"Unsupported FlashInfer patch command: {shlex.join(words)}"
                    )
                path = copied[inputs[0]]
                text = run(
                    "git", "-C", checkout, "show", f"{revision}:{PROJECT / path}"
                )
                patches.append((path.name, text))
                applied.add(path)
    if unused := set(copied.values()) - applied:
        raise RuntimeError(
            "FlashInfer patches lack a supported application command: "
            + ", ".join(str(path) for path in sorted(unused))
        )
    return versions.pop(), patches


def flashinfer_wheel(version, cache):
    with urllib.request.urlopen(
        f"https://pypi.org/pypi/flashinfer-python/{version}/json", timeout=60
    ) as response:
        metadata = json.load(response)
    wheels = [
        item
        for item in metadata["urls"]
        if item["filename"].endswith("-py3-none-any.whl")
    ]
    if len(wheels) != 1:
        raise RuntimeError(
            f"Expected one platform-independent FlashInfer {version} wheel"
        )
    artifact = wheels[0]
    filename = artifact["filename"]
    if Path(filename).name != filename:
        raise RuntimeError(f"Invalid FlashInfer wheel filename: {filename}")
    cache.mkdir(parents=True, exist_ok=True)
    wheel = cache / filename
    if not wheel.exists():
        with step(f"Downloading FlashInfer {version} source wheel"):
            with tempfile.TemporaryDirectory(
                prefix="download-", dir=cache
            ) as temporary:
                download = Path(temporary) / filename
                with urllib.request.urlopen(artifact["url"], timeout=60) as response:
                    with download.open("wb") as output:
                        shutil.copyfileobj(response, output)
                with download.open("rb") as contents:
                    digest = hashlib.file_digest(contents, "sha256").hexdigest()
                if digest != artifact["digests"]["sha256"]:
                    raise RuntimeError(f"FlashInfer {version} wheel checksum mismatch")
                download.replace(wheel)
    with wheel.open("rb") as contents:
        if (
            hashlib.file_digest(contents, "sha256").hexdigest()
            != artifact["digests"]["sha256"]
        ):
            raise RuntimeError(
                f"Cached FlashInfer {version} wheel checksum mismatch: {wheel}"
            )
    return wheel


def init_flashinfer(wheel, version, patches, source):
    source.mkdir()
    with zipfile.ZipFile(wheel) as contents:
        for member in contents.infolist():
            if not member.filename.startswith("flashinfer/") or member.is_dir():
                continue
            relative = Path(member.filename).relative_to("flashinfer")
            if any(part.lower() in ("..", ".git") for part in relative.parts):
                raise RuntimeError(f"Invalid FlashInfer wheel path: {member.filename}")
            path = source / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            with contents.open(member) as incoming, path.open("wb") as output:
                shutil.copyfileobj(incoming, output)
    if not any(source.iterdir()):
        raise RuntimeError(f"FlashInfer {version} wheel contains no flashinfer package")
    run("git", "init", "--template=", source)
    for key, value in (
        ("user.name", "PR review"),
        ("user.email", "pr-review@localhost"),
        ("commit.gpgsign", "false"),
        ("core.hooksPath", "/dev/null"),
    ):
        git(source, "config", key, value)
    git(source, "add", "--all", "--force")
    git(source, "commit", "-m", f"FlashInfer {version}")
    for name, text in patches:
        patch = source.parent / name
        patch.write_text(text)
        git(source, "apply", "--index", patch)
        git(source, "commit", "-m", name)


def prepare_flashinfer(baseline, head, state_path, state, stacks, cache):
    source = state_path.parent / "flashinfer"
    if source.exists():
        if "flashinfer_head" not in state:
            raise RuntimeError(
                f"{source} already exists and was not created by review-pr"
            )
        require_clean(source, state["flashinfer_head"])
        if state.get("flashinfer_revisions") == [baseline, head]:
            return source
    with step("Applying baseline and proposed FlashInfer stacks"):
        with tempfile.TemporaryDirectory(
            prefix="flashinfer-", dir=state_path.parent
        ) as temporary:
            scratch = Path(temporary)
            trees = []
            for label, (version, patches) in zip(("base", "head"), stacks, strict=True):
                tree = scratch / label
                init_flashinfer(
                    flashinfer_wheel(version, cache), version, patches, tree
                )
                trees.append(tree)
            source_head = publish_source(*trees, source)
            state.update(
                flashinfer_head=source_head, flashinfer_revisions=[baseline, head]
            )
            save_state(state_path, state)
    return source


def prepare(repo, number, work):
    name = repo.split("/")[1]
    checkout, worktree = work / name, work / f"{name}-pr{number}"
    if not checkout.exists():
        with step(f"Cloning {repo}"):
            run("gh", "repo", "clone", repo, checkout)
    with step(f"Fetching {repo}#{number}"):
        pr = json.loads(
            run(
                "gh",
                "pr",
                "view",
                number,
                "--repo",
                repo,
                "--json",
                "headRefOid,baseRefOid",
            )
        )
        head = pr["headRefOid"]
        git(
            checkout,
            "fetch",
            "--no-tags",
            f"https://github.com/{repo}.git",
            f"refs/pull/{number}/head",
            pr["baseRefOid"],
        )
        if git(checkout, "rev-parse", "FETCH_HEAD") != head:
            raise RuntimeError("The PR changed during fetch; run review-pr again")
        baseline = git(checkout, "merge-base", pr["baseRefOid"], head)
    state_path, state = prepare_worktree(checkout, worktree, repo, head)
    source = worktree / PROJECT / "sglang"
    if source.exists() and "source_head" in state:
        require_clean(source, state["source_head"])
    git(worktree, "checkout", "--detach", head)
    state["head"] = head
    save_state(state_path, state)
    changed_stack = repo == "basetenlabs/baseten" and git(
        checkout,
        "diff",
        "--name-only",
        baseline,
        head,
        "--",
        *STACK_PATHS,
    )
    sources = []
    if changed_stack:
        source = prepare_sglang(
            checkout,
            worktree,
            baseline,
            head,
            state_path,
            state,
            work / "sglang-review.git",
        )
        sources.append(("SGLang", source))
    if repo == "basetenlabs/baseten" and git(
        checkout, "diff", "--name-only", baseline, head, "--", *FLASHINFER_PATHS
    ):
        stacks = [flashinfer_stack(checkout, revision) for revision in (baseline, head)]
        if stacks[0] != stacks[1]:
            source = prepare_flashinfer(
                baseline, head, state_path, state, stacks, work / "flashinfer-review"
            )
            sources.append(("FlashInfer", source))
    diff_range = f"{baseline}..{head}"
    print(f"Review workspace: {worktree}", flush=True)
    for label, source in sources:
        print(f"Applied {label} source: {source}", flush=True)
    return worktree, sources, diff_range, state_path.parent


def review_tab(name, panes, *, focus=False):
    focused = " focus=true" if focus else ""
    return f"""    tab name={json.dumps(name)}{focused} {{
    pane size=1 borderless=true {{
        plugin location="zellij:tab-bar"
    }}
    {panes}
    pane size=1 borderless=true {{
        plugin location="zellij:status-bar"
    }}
    }}
"""


def layout(repo, number, worktree, sources, diff_range, *, include_agent=False):
    quote = json.dumps
    expanded = " expanded=true" if sources else ""
    diffs = f"""pane name="Full PR diff" command="nvim" close_on_exit=true focus=true{expanded} {{
        cwd {quote(str(worktree))}
        args "-c" {quote(f"DiffviewOpen {diff_range}")}
    }}"""
    if sources:
        for label, source in sources:
            diffs += f"""
            pane name="Applied {label} source" command="nvim" close_on_exit=true start_suspended=true {{
                cwd {quote(str(source))}
                args "-c" {quote(f"DiffviewOpen {BASE_REF}..{HEAD_REF}")}
            }}"""
        diffs = f"pane stacked=true {{\n{diffs}\n}}"
    panes = f'''pane split_direction="vertical" {{
        pane name="GitHub review #{number}" command="gh" close_on_exit=true {{
            cwd {quote(str(worktree))}
            args "pr-review" "{number}" "--repo" {quote(repo)}
        }}
        {diffs}
    }}
'''
    tabs = review_tab(f"PR {number}", panes, focus=True)
    if include_agent:
        tabs += agent_tab(repo, number, worktree)
    return f"layout {{\n{tabs}}}\n"


def agent_tab(repo, number, worktree):
    prompt = f"Review PR {repo}#{number} in this git worktree."
    # mini takes its project directory from cwd; only run and mini accept --model.
    pane = f"""pane name="OpenCode review" command="opencode" close_on_exit=true {{
        cwd {json.dumps(str(worktree))}
        args "mini" "--model" {json.dumps(REVIEW_MODEL)} "--prompt" {json.dumps(prompt)}
    }}"""
    return review_tab(f"AI review {number}", pane)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("number", type=int)
    parser.add_argument("--repo", default="basetenlabs/baseten")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--prepare-only",
        action="store_true",
        help="Prepare the review without opening its views",
    )
    mode.add_argument(
        "--ai",
        action="store_true",
        help="Open the manual review and interactive OpenCode together",
    )
    args = parser.parse_args()
    if args.number <= 0 or not re.fullmatch(r"[\w.-]+/[\w.-]+", args.repo):
        parser.error("Use a positive PR number and an owner/repo name")
    work = Path.home() / "work"
    work.mkdir(exist_ok=True)
    with (work / ".pr-review.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        worktree, sources, diff_range, metadata = prepare(args.repo, args.number, work)
    view = metadata / ("agent.kdl" if args.ai else "layout.kdl")
    view.write_text(
        layout(
            args.repo, args.number, worktree, sources, diff_range, include_agent=args.ai
        )
    )
    if args.prepare_only:
        return
    if os.environ.get("ZELLIJ_SESSION_NAME"):
        run(
            "zellij",
            "action",
            "new-tab",
            "--layout",
            view,
        )
    else:
        os.execvp("zellij", ["zellij", "--layout", str(view)])


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as exc:
        print(f"review-pr: {exc}", file=sys.stderr)
        if sys.stdin.isatty():
            input("Press Enter to return to the inbox.")
        sys.exit(1)
