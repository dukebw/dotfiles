#!/usr/bin/env bash
set -euo pipefail

# r - Run remote with auto-flush and local log capture.
# Convenience wrapper: flushes Mutagen sync, executes via rexec, logs each run
# to a unique history file, and updates the shared latest log on exit.

if [[ $# -eq 0 ]]; then
  echo "Usage: r <command> [args...]" >&2
  exit 2
fi

# Default alongside rlog's local mirrored outputs.
LOG_ROOT="${R_SHARED_LOG_ROOT:-$HOME/shared/b200-hydra/logs/r}"
DEFAULT_LATEST_LOG="$LOG_ROOT/latest.log"
RUN_TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
RUN_LOG="${R_LATEST_LOG:-$LOG_ROOT/history/${RUN_TIMESTAMP}-$$.log}"

mkdir -p "$(dirname "$RUN_LOG")"
mkdir -p "$(dirname "$DEFAULT_LATEST_LOG")"
: > "$RUN_LOG"

echo "r: logging stdout/stderr to $RUN_LOG" >&2
if [[ "$RUN_LOG" != "$DEFAULT_LATEST_LOG" ]]; then
  echo "r: latest log will update to $DEFAULT_LATEST_LOG on exit" >&2
fi

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/r.XXXXXX")"
cleanup() {
  rm -rf "$tmpdir"
}
trap cleanup EXIT

stdout_pipe="$tmpdir/stdout.pipe"
stderr_pipe="$tmpdir/stderr.pipe"
mkfifo "$stdout_pipe" "$stderr_pipe"

exec 3>&1 4>&2
tee -a "$RUN_LOG" >(cat >&3) <"$stdout_pipe" >/dev/null &
stdout_tee_pid=$!
tee >(cat >&4) >(perl -pe 's/\e\[[0-9;?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\\\)//g; s/\e[@-_]//g' >>"$RUN_LOG") <"$stderr_pipe" >/dev/null &
stderr_tee_pid=$!

status=0
if [[ -t 2 ]]; then
  REXEC_FORCE_COLOR=1 rexec --flush "$@" >"$stdout_pipe" 2>"$stderr_pipe" || status=$?
else
  rexec --flush "$@" >"$stdout_pipe" 2>"$stderr_pipe" || status=$?
fi

wait "$stdout_tee_pid"
wait "$stderr_tee_pid"

if [[ "$RUN_LOG" != "$DEFAULT_LATEST_LOG" ]]; then
  latest_tmp="$tmpdir/latest.log"
  cp -f "$RUN_LOG" "$latest_tmp"
  mv -f "$latest_tmp" "$DEFAULT_LATEST_LOG"
fi

exit "$status"
