#!/usr/bin/env python3
"""Baseten GPU dev-node helper.

This CLI wraps the small set of Kubernetes/DCGM operations needed for Vultr B200
dev nodes: discover schedulable nodes, inspect GPU usage, map host GPU processes
back to pods, and move a dev pod to a target node.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

DEFAULT_RCLI_KUBECONFIG_DIR = Path.home() / ".rcli" / "kubeconfig"
DEFAULT_GPU_PRODUCT = "NVIDIA-B200"
DEFAULT_DEBUG_NAMESPACE = "default"
DEFAULT_FLEET_NAMESPACES = ("baseten", "baseten-devenv")


class CommandError(RuntimeError):
    pass


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def run(
    cmd: list[str],
    *,
    capture: bool = True,
    check: bool = True,
    input_text: str | None = None,
    timeout_sec: int | None = None,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        cmd,
        input=input_text,
        capture_output=capture,
        text=True,
        check=False,
        timeout=timeout_sec,
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        command = shlex.join(cmd)
        if detail:
            raise CommandError(f"Command failed: {command}\n{detail}")
        raise CommandError(f"Command failed: {command}")
    return result


def current_kubectl_context() -> str:
    result = run(["kubectl", "config", "current-context"], capture=True)
    context = result.stdout.strip()
    if not context:
        raise CommandError("No current kubectl context. Run `rcli select` first.")
    return context


def rcli_kubeconfig_for_context(context: str) -> str:
    root = DEFAULT_RCLI_KUBECONFIG_DIR
    candidates = []
    direct = root / f"{context}.yaml"
    if direct.exists():
        candidates.append(direct)
    candidates.extend(sorted(path for path in root.glob(f"*/{context}.yaml") if path.exists()))
    if not candidates:
        raise CommandError(
            f"No rcli kubeconfig found for current context {context!r} under {root}. "
            "Run `rcli sync`, then `rcli select`."
        )
    if len(candidates) > 1:
        joined = ", ".join(str(path) for path in candidates)
        raise CommandError(f"Multiple rcli kubeconfigs found for current context {context!r}: {joined}")
    return str(candidates[0])


def base_context(args: argparse.Namespace) -> dict[str, Any]:
    context = current_kubectl_context()
    return {
        "context": context,
        "kubeconfig": rcli_kubeconfig_for_context(context),
        "namespace": args.namespace or "baseten",
        "pod": args.pod,
        "gpu_product": args.gpu_product,
        "debug_namespace": args.debug_namespace,
        "json": args.json,
    }


def kubectl(ctx: dict[str, Any], args: list[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
    return run(["kubectl", "--kubeconfig", ctx["kubeconfig"], *args], **kwargs)


def kubectl_json(ctx: dict[str, Any], args: list[str]) -> Any:
    result = kubectl(ctx, [*args, "-o", "json"], capture=True)
    return json.loads(result.stdout)


def is_node_ready(node: dict[str, Any]) -> bool:
    for condition in node.get("status", {}).get("conditions", []):
        if condition.get("type") == "Ready":
            return condition.get("status") == "True"
    return False


def ready_condition(node: dict[str, Any]) -> dict[str, Any]:
    for condition in node.get("status", {}).get("conditions", []):
        if condition.get("type") == "Ready":
            return condition
    return {}


def allocatable_gpus(node: dict[str, Any]) -> int:
    value = node.get("status", {}).get("allocatable", {}).get("nvidia.com/gpu", "0")
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def node_name(node: dict[str, Any]) -> str:
    return node["metadata"]["name"]


def list_assignable_nodes(ctx: dict[str, Any]) -> list[dict[str, Any]]:
    nodes = kubectl_json(
        ctx,
        ["get", "nodes", "-l", f"nvidia.com/gpu.product={ctx['gpu_product']}"],
    ).get("items", [])
    assignable = []
    for node in nodes:
        if not is_node_ready(node):
            continue
        if node.get("spec", {}).get("unschedulable") is True:
            continue
        if allocatable_gpus(node) <= 0:
            continue
        assignable.append(node)
    return sorted(assignable, key=node_name)


def no_assignable_nodes_error(ctx: dict[str, Any]) -> CommandError:
    nodes = kubectl_json(
        ctx,
        ["get", "nodes", "-l", f"nvidia.com/gpu.product={ctx['gpu_product']}"],
    ).get("items", [])
    if not nodes:
        return CommandError(f"No {ctx['gpu_product']} nodes found")

    details = []
    for node in sorted(nodes, key=node_name):
        condition = ready_condition(node)
        status = condition.get("status", "<missing>")
        reason = condition.get("reason", "<missing>")
        gpu_count = allocatable_gpus(node)
        unschedulable = node.get("spec", {}).get("unschedulable") is True
        flags = [f"Ready={status}", f"reason={reason}", f"gpu={gpu_count}"]
        if unschedulable:
            flags.append("unschedulable=true")
        details.append(f"{node_name(node)} ({', '.join(flags)})")

    return CommandError(
        f"No assignable {ctx['gpu_product']} nodes found. Current candidates: " + "; ".join(details)
    )


def resolve_node(ctx: dict[str, Any], value: str) -> str:
    nodes = [node_name(node) for node in list_assignable_nodes(ctx)]
    if value in nodes:
        return value
    matches = [name for name in nodes if name.endswith(value)]
    if not matches:
        raise CommandError(f"Unknown assignable {ctx['gpu_product']} node suffix/name: {value}")
    if len(matches) > 1:
        raise CommandError(f"Ambiguous node suffix {value}: {', '.join(matches)}")
    return matches[0]


def gpu_status(ctx: dict[str, Any], nodes: list[str]) -> list[dict[str, Any]]:
    rows = []
    for node in nodes:
        debugger_pod = ""
        try:
            debugger_pod = create_node_debugger(ctx, node, status_debug_script())
            logs = wait_for_debug_logs(ctx, debugger_pod)
            data = parse_owner_logs(logs, {})
            rows.append({"node": node, "gpus": data["summary"]})
        except CommandError as exc:
            rows.append({"node": node, "error": str(exc), "gpus": []})
        finally:
            if debugger_pod:
                delete_debugger(ctx, debugger_pod)
    return rows


def pod_ready_summary(pod: dict[str, Any]) -> str:
    statuses = pod.get("status", {}).get("containerStatuses", [])
    if not statuses:
        return "0/0"
    ready = sum(1 for status in statuses if status.get("ready"))
    return f"{ready}/{len(statuses)}"


def pods_on_node(ctx: dict[str, Any], node: str) -> list[dict[str, str]]:
    pods = kubectl_json(
        ctx,
        ["get", "pods", "-A", "--field-selector", f"spec.nodeName={node}"],
    ).get("items", [])
    rows = []
    for pod in pods:
        rows.append(
            {
                "namespace": pod.get("metadata", {}).get("namespace", ""),
                "name": pod.get("metadata", {}).get("name", ""),
                "phase": pod.get("status", {}).get("phase", ""),
                "ready": pod_ready_summary(pod),
                "node": pod.get("spec", {}).get("nodeName", ""),
            }
        )
    return sorted(rows, key=lambda row: (row["namespace"], row["name"]))


def pod_uid_map(ctx: dict[str, Any]) -> dict[str, dict[str, str]]:
    pods = kubectl_json(ctx, ["get", "pods", "-A"]).get("items", [])
    result: dict[str, dict[str, str]] = {}
    for pod in pods:
        metadata = pod.get("metadata", {})
        uid = metadata.get("uid")
        if uid:
            result[uid] = {
                "namespace": metadata.get("namespace", ""),
                "name": metadata.get("name", ""),
                "node": pod.get("spec", {}).get("nodeName", ""),
            }
    return result


def extract_pod_uid(cgroup: str) -> str | None:
    match = re.search(r"pod([0-9a-f]{8}[_-][0-9a-f]{4}[_-][0-9a-f]{4}[_-][0-9a-f]{4}[_-][0-9a-f]{12})", cgroup)
    if not match:
        return None
    return match.group(1).replace("_", "-")


def owner_name(cgroup: str, pods_by_uid: dict[str, dict[str, str]]) -> str:
    uid = extract_pod_uid(cgroup)
    if uid and uid in pods_by_uid:
        pod = pods_by_uid[uid]
        return f"{pod['namespace']}/{pod['name']}"
    if "system.slice" in cgroup:
        return "host/systemd"
    if cgroup.startswith("0::/docker/"):
        return "nested-docker"
    return "unknown"


def debug_script() -> str:
    return r'''
set -uo pipefail
owner_cgroup() {
  local pid="$1"
  local cur="$pid"
  local original=""
  while [ -n "$cur" ] && [ "$cur" != "0" ]; do
    local cg
    # nsenter into the host cgroup namespace: read from the debug pod's own
    # namespace, nested-docker (dev pod) processes show a bare /docker/<id>
    # path with no kubepods pod uid.
    cg=$(nsenter -t 1 -C -- cat "/proc/$cur/cgroup" 2>/dev/null | tr '\n' ';' || true)
    if [ -z "$original" ]; then original="$cg"; fi
    case "$cg" in
      *kubepods*pod*) echo "$cg"; return ;;
    esac
    cur=$(awk '/^PPid:/ {print $2}' "/proc/$cur/status" 2>/dev/null || true)
  done
  echo "$original"
}

echo "B10_GPU_SECTION|summary"
nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits 2>/dev/null \
  | while IFS= read -r line; do echo "B10_GPU_SUMMARY|$line"; done

echo "B10_GPU_SECTION|compute"
nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null \
  | while IFS= read -r line; do
      pid=$(printf '%s\n' "$line" | awk -F',' '{gsub(/^ +| +$/, "", $2); print $2}')
      cg=$(owner_cgroup "$pid")
      echo "B10_GPU_COMPUTE|$line|$cg"
    done

echo "B10_GPU_SECTION|handles"
# Single find pass: readlink happens in C. The old per-fd bash loop forked a
# readlink for every fd of every process on the host and never finished on
# busy nodes.
find /proc/[0-9]*/fd -lname '/dev/nvidia*' 2>/dev/null \
  | awk -F/ '{print $3}' | sort -un \
  | while read -r pid; do
      cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
      cg=$(owner_cgroup "$pid")
      echo "B10_GPU_HANDLE|$pid|$cmdline|$cg"
    done
echo "B10_GPU_DONE"
'''


def status_debug_script() -> str:
    return r'''
set -uo pipefail
echo "B10_GPU_SECTION|summary"
nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader,nounits 2>/dev/null \
  | while IFS= read -r line; do echo "B10_GPU_SUMMARY|$line"; done
echo "B10_GPU_DONE"
'''


def create_node_debugger(ctx: dict[str, Any], node: str, script: str) -> str:
    cmd = [
        "kubectl",
        "--kubeconfig",
        ctx["kubeconfig"],
        "-n",
        ctx["debug_namespace"],
        "debug",
        f"node/{node}",
        "--image=ubuntu:22.04",
        "--profile=sysadmin",
        "--",
        "chroot",
        "/host",
        "bash",
        "-lc",
        script,
    ]
    result = run(cmd, capture=True, check=True)
    output = "\n".join(part for part in [result.stdout, result.stderr] if part)
    match = re.search(r"Creating debugging pod (\S+)", output)
    if not match:
        raise CommandError(f"Could not determine node debugger pod name from kubectl debug output:\n{output}")
    return match.group(1)


def wait_for_debug_logs(ctx: dict[str, Any], pod: str, timeout_sec: int = 60) -> str:
    deadline = time.monotonic() + timeout_sec
    last_output = ""
    while time.monotonic() < deadline:
        result = kubectl(
            ctx,
            ["logs", "-n", ctx["debug_namespace"], pod],
            capture=True,
            check=False,
        )
        if result.returncode == 0:
            last_output = result.stdout
            if "B10_GPU_DONE" in result.stdout:
                return result.stdout
        phase = kubectl(
            ctx,
            ["get", "pod", "-n", ctx["debug_namespace"], pod, "-o", "jsonpath={.status.phase}"],
            capture=True,
            check=False,
        )
        if phase.stdout.strip() in {"Succeeded", "Failed"} and last_output:
            return last_output
        time.sleep(1)
    raise CommandError(f"Timed out waiting for node debugger logs from {pod}")


def delete_debugger(ctx: dict[str, Any], pod: str) -> None:
    kubectl(
        ctx,
        ["delete", "pod", "-n", ctx["debug_namespace"], pod, "--ignore-not-found=true"],
        capture=True,
        check=False,
    )


def parse_owner_logs(text: str, pods_by_uid: dict[str, dict[str, str]]) -> dict[str, Any]:
    summary = []
    compute = []
    handles = []
    for line in text.splitlines():
        if line.startswith("B10_GPU_SUMMARY|"):
            parts = [part.strip() for part in line.removeprefix("B10_GPU_SUMMARY|").split(",")]
            if len(parts) >= 3:
                summary.append(
                    {
                        "gpu": int(parts[0]),
                        "memory_used_mib": int(float(parts[1])),
                        "utilization_gpu_pct": int(float(parts[2])),
                    }
                )
        elif line.startswith("B10_GPU_COMPUTE|"):
            _, csv_row, cgroup = line.split("|", 2)
            parts = [part.strip() for part in csv_row.split(",", 3)]
            if len(parts) >= 4:
                compute.append(
                    {
                        "gpu_uuid": parts[0],
                        "pid": parts[1],
                        "process_name": parts[2],
                        "memory_used_mib": parts[3],
                        "owner": owner_name(cgroup, pods_by_uid),
                        "cgroup": cgroup,
                    }
                )
        elif line.startswith("B10_GPU_HANDLE|"):
            _, pid, cmdline, cgroup = line.split("|", 3)
            handles.append(
                {
                    "pid": pid,
                    "cmdline": cmdline,
                    "owner": owner_name(cgroup, pods_by_uid),
                    "cgroup": cgroup,
                }
            )
    summary.sort(key=lambda row: row["gpu"])
    handles.sort(key=lambda row: (row["owner"], row["cmdline"], row["pid"]))
    return {"summary": summary, "compute": compute, "handles": handles}


def infer_statefulset_name(pod: str) -> str:
    match = re.match(r"^(?P<name>.+)-\d+$", pod)
    if not match:
        raise CommandError(f"Cannot infer StatefulSet name from pod name: {pod}")
    return match.group("name")


def current_pod_node(ctx: dict[str, Any], namespace: str, pod: str) -> str:
    obj = kubectl_json(ctx, ["get", "pod", "-n", namespace, pod])
    node = obj.get("spec", {}).get("nodeName")
    if not node:
        raise CommandError(f"Pod {namespace}/{pod} is not scheduled on a node")
    return node


def patch_statefulset_node(ctx: dict[str, Any], namespace: str, statefulset: str, node: str) -> None:
    patch = {"spec": {"template": {"spec": {"nodeSelector": {"kubernetes.io/hostname": node}}}}}
    kubectl(
        ctx,
        ["-n", namespace, "patch", "statefulset", statefulset, "--type", "merge", "-p", json.dumps(patch)],
        capture=True,
    )


def wait_for_pod_on_node(ctx: dict[str, Any], namespace: str, pod: str, node: str, timeout_sec: int = 300) -> None:
    deadline = time.monotonic() + timeout_sec
    while time.monotonic() < deadline:
        obj = kubectl_json(ctx, ["get", "pod", "-n", namespace, pod])
        phase = obj.get("status", {}).get("phase")
        current_node = obj.get("spec", {}).get("nodeName")
        if phase == "Running" and current_node == node:
            return
        eprint(f"Waiting for {namespace}/{pod}: phase={phase}, node={current_node}")
        time.sleep(5)
    raise CommandError(f"Timed out waiting for {namespace}/{pod} to run on {node}")


def rexec_setup_and_sync(rexec_config: str | None) -> None:
    cmd = ["rexec"]
    if rexec_config:
        cmd.extend(["--config", rexec_config])
    # --flush waits for the full re-push and auto-resets a session that Mutagen
    # safety-halted because the new node's /workspace came back empty. The halt
    # often only appears after --setup returns (the daemon reconnects
    # asynchronously), so the flush retry loop is what reliably repairs it.
    cmd.extend(["--setup", "--flush"])
    run(cmd, capture=False)


def print_nodes(ctx: dict[str, Any]) -> None:
    rows = [node_name(node) for node in list_assignable_nodes(ctx)]
    if ctx["json"]:
        print(json.dumps(rows, indent=2))
        return
    for row in rows:
        print(row)


def print_status(ctx: dict[str, Any], rows: list[dict[str, Any]]) -> None:
    if ctx["json"]:
        print(json.dumps(rows, indent=2))
        return
    for node_row in rows:
        print(node_row["node"])
        if node_row.get("error"):
            print(f"  error: {node_row['error']}")
            continue
        for gpu in node_row["gpus"]:
            mem = gpu["memory_used_mib"]
            util = gpu["utilization_gpu_pct"]
            print(f"  GPU {gpu['gpu']}: {mem} MiB, {util}% util")


def print_pods(ctx: dict[str, Any], rows: list[dict[str, str]]) -> None:
    if ctx["json"]:
        print(json.dumps(rows, indent=2))
        return
    for row in rows:
        print(f"{row['namespace']}/{row['name']}\t{row['phase']}\t{row['ready']}\t{row['node']}")


def print_owner(ctx: dict[str, Any], node: str, data: dict[str, Any]) -> None:
    if ctx["json"]:
        output = {"node": node, **data}
        print(json.dumps(output, indent=2))
        return
    print(node)
    print("GPU summary:")
    for row in data["summary"]:
        print(f"  GPU {row['gpu']}: {row['memory_used_mib']} MiB, {row['utilization_gpu_pct']}% util")
    print("Compute apps:")
    if data["compute"]:
        for row in data["compute"]:
            print(
                f"  PID {row['pid']} owner={row['owner']} mem={row['memory_used_mib']} MiB process={row['process_name']}"
            )
    else:
        print("  none")
    print("Device-handle processes:")
    for row in data["handles"]:
        command = row["cmdline"] or "<empty cmdline>"
        print(f"  PID {row['pid']} owner={row['owner']} command={command}")


def cmd_nodes(args: argparse.Namespace) -> None:
    print_nodes(base_context(args))


def cmd_status(args: argparse.Namespace) -> None:
    ctx = base_context(args)
    if args.all:
        nodes = [node_name(node) for node in list_assignable_nodes(ctx)]
        if not nodes:
            raise no_assignable_nodes_error(ctx)
    elif args.node:
        nodes = [resolve_node(ctx, args.node)]
    else:
        raise CommandError("Pass --all or a node suffix/name")
    print_status(ctx, gpu_status(ctx, nodes))


def cmd_pods(args: argparse.Namespace) -> None:
    ctx = base_context(args)
    node = resolve_node(ctx, args.node)
    print_pods(ctx, pods_on_node(ctx, node))


def cmd_owner(args: argparse.Namespace) -> None:
    ctx = base_context(args)
    node = resolve_node(ctx, args.node)
    debugger_pod = create_node_debugger(ctx, node, debug_script())
    try:
        # The owner script scans every /proc/*/fd on the host; busy nodes
        # exceed the default 60s comfortably.
        logs = wait_for_debug_logs(ctx, debugger_pod, timeout_sec=240)
        data = parse_owner_logs(logs, pod_uid_map(ctx))
        print_owner(ctx, node, data)
    finally:
        delete_debugger(ctx, debugger_pod)


def owned_pods(
    ctx: dict[str, Any],
    namespaces: list[str],
    owner_prefix: str,
    all_phases: bool,
) -> list[dict[str, str]]:
    data = kubectl_json(ctx, ["get", "pods", "--all-namespaces", "-o", "json"])
    namespace_set = set(namespaces)
    rows = []
    for pod in data.get("items", []):
        metadata = pod.get("metadata", {})
        namespace = metadata.get("namespace", "")
        name = metadata.get("name", "")
        if namespace not in namespace_set or not name.startswith(owner_prefix):
            continue
        phase = pod.get("status", {}).get("phase", "")
        if not all_phases and phase != "Running":
            continue
        rows.append(
            {
                "namespace": namespace,
                "name": name,
                "node": pod.get("spec", {}).get("nodeName", ""),
                "phase": phase,
                "ready": pod_ready_summary(pod),
            }
        )
    return sorted(rows, key=lambda row: (row["namespace"], row["name"]))


def cmd_fleet(args: argparse.Namespace) -> None:
    """List the pods you own (name-prefix convention) — the fleet.

    Kubernetes is the authority for fleet membership; .rexec*.yaml files are
    sync plumbing and deliberately play no part here (see dotfiles ADR 0001).
    """
    ctx = base_context(args)
    owner = args.owner or os.environ.get("FLEET_USER") or os.environ.get("USER", "")
    if not owner:
        raise CommandError("Cannot determine owner: pass --owner or set FLEET_USER/USER")
    namespaces = [args.namespace] if args.namespace else list(DEFAULT_FLEET_NAMESPACES)
    pods = owned_pods(ctx, namespaces, owner, args.all_phases)
    if ctx["json"]:
        print(
            json.dumps(
                {
                    "owner": owner,
                    "namespaces": namespaces,
                    "kubeconfig": ctx["kubeconfig"],
                    "pods": pods,
                },
                indent=2,
            )
        )
        return
    if not pods:
        print(f"No pods owned by {owner!r} in namespaces {', '.join(namespaces)}")
        return
    for pod in pods:
        print(
            f"{pod['namespace']}/{pod['name']}\t"
            f"{pod['phase']}\t{pod['ready']}\t{pod['node']}"
        )


def cmd_move(args: argparse.Namespace) -> None:
    ctx = base_context(args)
    namespace = args.pod_namespace or ctx["namespace"]
    pod = args.move_pod or ctx.get("pod")
    if not pod:
        raise CommandError("Missing pod. Pass --pod.")
    statefulset = args.statefulset or infer_statefulset_name(pod)
    target_node = resolve_node(ctx, args.node)
    current_node = current_pod_node(ctx, namespace, pod)
    if args.from_node:
        expected_source = resolve_node(ctx, args.from_node)
        if current_node != expected_source:
            raise CommandError(f"Refusing move: {namespace}/{pod} is on {current_node}, not {expected_source}")

    plan = {
        "namespace": namespace,
        "pod": pod,
        "statefulset": statefulset,
        "current_node": current_node,
        "target_node": target_node,
    }
    if ctx["json"]:
        print(json.dumps({"plan": plan, "dry_run": args.dry_run}, indent=2))
    else:
        print("Move plan:")
        for key, value in plan.items():
            print(f"  {key}: {value}")

    if current_node == target_node:
        print("Already on target node; no move needed.")
        return
    if args.dry_run:
        print("Dry run: no changes made.")
        return
    if not args.yes:
        if not sys.stdin.isatty():
            raise CommandError("Refusing to move pod without --yes in non-interactive mode")
        answer = input("Patch StatefulSet and recreate pod? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            raise CommandError("Aborted")

    patch_statefulset_node(ctx, namespace, statefulset, target_node)
    kubectl(ctx, ["-n", namespace, "rollout", "status", f"statefulset/{statefulset}", "--timeout=300s"], capture=False)
    wait_for_pod_on_node(ctx, namespace, pod, target_node)
    if args.skip_rexec:
        print("Skipping rexec refresh by request.")
        return
    rexec_setup_and_sync(args.rexec_config)
    print("Move complete.")


def add_common_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--namespace", help="Default dev pod namespace")
    parser.add_argument("--pod", help="Default rexec/dev pod name")
    parser.add_argument("--gpu-product", default=DEFAULT_GPU_PRODUCT, help="GPU product label value")
    parser.add_argument("--debug-namespace", default=DEFAULT_DEBUG_NAMESPACE, help="Namespace for node debug pods")
    parser.add_argument("--json", action="store_true", help="Print JSON output")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Baseten Vultr B200 GPU dev-node helper using the rcli-selected Kubernetes context"
    )
    add_common_args(parser)
    subparsers = parser.add_subparsers(dest="command", required=True)

    nodes = subparsers.add_parser("nodes", help="List assignable GPU nodes")
    nodes.set_defaults(func=cmd_nodes)

    status = subparsers.add_parser("status", help="Show GPU memory/utilization")
    status.add_argument("node", nargs="?", help="Node full name or unique suffix")
    status.add_argument("--all", action="store_true", help="Show all assignable nodes")
    status.set_defaults(func=cmd_status)

    pods = subparsers.add_parser("pods", help="List pods scheduled on a node")
    pods.add_argument("node", help="Node full name or unique suffix")
    pods.set_defaults(func=cmd_pods)

    owner = subparsers.add_parser("owner", help="Map host GPU processes back to pods")
    owner.add_argument("node", help="Node full name or unique suffix")
    owner.set_defaults(func=cmd_owner)

    fleet = subparsers.add_parser("fleet", help="List pods you own (the fleet)")
    fleet.add_argument("--owner", help="Owner name prefix; defaults to $FLEET_USER then $USER")
    fleet.add_argument("--all-phases", action="store_true", help="Include non-Running pods")
    fleet.set_defaults(func=cmd_fleet)

    move = subparsers.add_parser("move", help="Move a dev pod to a node")
    move.add_argument("node", help="Target node full name or unique suffix")
    move.add_argument("--from", dest="from_node", help="Expected current node suffix/name")
    move.add_argument("--pod", dest="move_pod", help="Pod to move")
    move.add_argument("--pod-namespace", help="Namespace for --pod; defaults to --namespace/rexec namespace")
    move.add_argument("--statefulset", help="StatefulSet to patch; inferred from pod name by default")
    move.add_argument("--dry-run", action="store_true", help="Print plan without changing anything")
    move.add_argument("--yes", action="store_true", help="Do not prompt before moving")
    move.add_argument("--skip-rexec", action="store_true", help="Do not run rexec/Mutagen refresh after move")
    move.add_argument(
        "--rexec-config",
        help="rexec config YAML for the post-move refresh; defaults to rexec's normal discovery from the current directory",
    )
    move.set_defaults(func=cmd_move)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    try:
        args.func(args)
    except KeyboardInterrupt:
        eprint("Interrupted")
        raise SystemExit(130)
    except CommandError as exc:
        eprint(f"error: {exc}")
        raise SystemExit(1)


if __name__ == "__main__":
    main()
