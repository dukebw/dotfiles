#!/usr/bin/env python3
"""Baseten GPU fleet query.

Lists the GPU containers you own across the dev and serving namespaces of an
rcli Kubernetes context. bin/gpu-fleet builds its Zellij monitor panes on this
query (see dotfiles ADR 0001).
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Any

import yaml

DEFAULT_RCLI_KUBECONFIG_DIR = Path.home() / ".rcli" / "kubeconfig"
DEFAULT_FLEET_NAMESPACES = ("baseten", "baseten-devenv", "dynamo", "mp-devenv")


class CommandError(RuntimeError):
    pass


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def run(
    cmd: list[str],
    *,
    capture: bool = True,
    check: bool = True,
    input_text: str | None = None,
    timeout_sec: int | None = None,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        cmd,
        input=input_text,
        capture_output=capture,
        text=True,
        check=False,
        timeout=timeout_sec,
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        command = shlex.join(cmd)
        if detail:
            raise CommandError(f"Command failed: {command}\n{detail}")
        raise CommandError(f"Command failed: {command}")
    return result


def current_kubectl_context() -> str:
    result = run(["kubectl", "config", "current-context"], capture=True)
    context = result.stdout.strip()
    if not context:
        raise CommandError("No current kubectl context. Run `rcli select` first.")
    return context


def rcli_kubeconfig_for_context(context: str) -> str:
    root = DEFAULT_RCLI_KUBECONFIG_DIR
    candidates = []
    direct = root / f"{context}.yaml"
    if direct.exists():
        candidates.append(direct)
    candidates.extend(sorted(path for path in root.glob(f"*/{context}.yaml") if path.exists()))
    if not candidates:
        raise CommandError(
            f"No rcli kubeconfig found for current context {context!r} under {root}. "
            "Run `rcli sync`, then `rcli select`."
        )
    if len(candidates) > 1:
        config_path = root.parent / "config.yaml"
        if config_path.exists():
            try:
                config = yaml.safe_load(config_path.read_text()) or {}
            except yaml.YAMLError as exc:
                raise CommandError(f"Invalid YAML in rcli config {config_path}") from exc
            if not isinstance(config, dict):
                raise CommandError(f"Expected a mapping in rcli config {config_path}")
            provider = config.get("default_provider")
            if provider is not None and not isinstance(provider, str):
                raise CommandError(f"Expected default_provider to be a string in {config_path}")
            if provider:
                preferred = root / provider / f"{context}.yaml"
                if preferred in candidates:
                    return str(preferred)
        joined = ", ".join(str(path) for path in candidates)
        raise CommandError(
            f"Multiple rcli kubeconfigs found for current context {context!r}: {joined}. "
            f"Select a matching default_provider in {config_path}."
        )
    return str(candidates[0])


def base_context(args: argparse.Namespace) -> dict[str, Any]:
    context = args.context or current_kubectl_context()
    return {
        "context": context,
        "kubeconfig": rcli_kubeconfig_for_context(context),
        "json": args.json,
    }


def kubectl(ctx: dict[str, Any], args: list[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
    return run(["kubectl", "--kubeconfig", ctx["kubeconfig"], *args], **kwargs)


def kubectl_json(ctx: dict[str, Any], args: list[str]) -> Any:
    result = kubectl(ctx, [*args, "-o", "json"], capture=True)
    return json.loads(result.stdout)


def allocatable_gpus(node: dict[str, Any]) -> int:
    value = node.get("status", {}).get("allocatable", {}).get("nvidia.com/gpu", "0")
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def node_name(node: dict[str, Any]) -> str:
    return node["metadata"]["name"]


def pod_ready_summary(pod: dict[str, Any]) -> str:
    statuses = pod.get("status", {}).get("containerStatuses", [])
    if not statuses:
        return "0/0"
    ready = sum(1 for status in statuses if status.get("ready"))
    return f"{ready}/{len(statuses)}"


def container_gpu_request(container: dict[str, Any]) -> int:
    value = container.get("resources", {}).get("requests", {}).get("nvidia.com/gpu", "0")
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def gpu_containers(pod: dict[str, Any]) -> list[dict[str, Any]]:
    result = []
    for container in pod.get("spec", {}).get("containers", []):
        gpus = container_gpu_request(container)
        if gpus > 0:
            result.append({"name": container.get("name", ""), "gpus": gpus})
    return result


def container_is_running(pod: dict[str, Any], container_name: str) -> bool:
    return any(
        status.get("name") == container_name
        and "running" in status.get("state", {})
        for status in pod.get("status", {}).get("containerStatuses", [])
    )


def pod_matches_owner(pod: dict[str, Any], owner: str) -> bool:
    metadata = pod.get("metadata", {})
    labels = metadata.get("labels", {})
    identities = (
        metadata.get("name", ""),
        labels.get("baseten.co/model", ""),
        labels.get("app.kubernetes.io/instance", ""),
    )
    return any(owner in identity for identity in identities)


def privileged_containers(pod: dict[str, Any]) -> list[str]:
    return [
        container.get("name", "")
        for container in pod.get("spec", {}).get("containers", [])
        if (container.get("securityContext") or {}).get("privileged")
    ]


def observer_rows(
    ctx: dict[str, Any], observers: list[tuple[dict[str, Any], str]]
) -> list[tuple[dict[str, Any], str, int]]:
    # Resolve observer candidates against node capacity so a privileged pod on
    # a GPU-less node never spawns a dead monitor pane.
    if not observers:
        return []
    nodes = kubectl_json(ctx, ["get", "nodes"])
    gpus_by_node = {
        node_name(node): allocatable_gpus(node) for node in nodes.get("items", [])
    }
    result = []
    for pod, container_name in observers:
        gpus = gpus_by_node.get(pod.get("spec", {}).get("nodeName", ""), 0)
        if gpus > 0:
            result.append((pod, container_name, gpus))
    return result


def fleet_row(pod: dict[str, Any], container_name: str, gpus: int) -> dict[str, Any]:
    metadata = pod.get("metadata", {})
    return {
        "namespace": metadata.get("namespace", ""),
        "name": metadata.get("name", ""),
        "container": container_name,
        "gpus": gpus,
        "model": metadata.get("labels", {}).get("baseten.co/model", ""),
        "node": pod.get("spec", {}).get("nodeName", ""),
        "phase": pod.get("status", {}).get("phase", ""),
        "ready": pod_ready_summary(pod),
    }


def owned_pods(
    ctx: dict[str, Any],
    namespaces: list[str],
    owner: str,
    all_phases: bool,
) -> list[dict[str, Any]]:
    phase_filter = [] if all_phases else ["--field-selector", "status.phase=Running"]

    def namespace_pods(namespace: str) -> list[dict[str, Any]]:
        return kubectl_json(
            ctx, ["get", "pods", "--namespace", namespace, *phase_filter]
        ).get("items", [])

    with ThreadPoolExecutor(max_workers=4) as pool:
        pods = [
            pod
            for items in pool.map(namespace_pods, dict.fromkeys(namespaces))
            for pod in items
        ]
    namespace_set = set(namespaces)
    rows = []
    observers: list[tuple[dict[str, Any], str]] = []
    for pod in pods:
        metadata = pod.get("metadata", {})
        if metadata.get("namespace", "") not in namespace_set or not pod_matches_owner(
            pod, owner
        ):
            continue
        phase = pod.get("status", {}).get("phase", "")
        if not all_phases and phase != "Running":
            continue
        containers = gpu_containers(pod)
        if not containers:
            # Privileged dev pods request no nvidia.com/gpu yet see every GPU
            # on their node via device passthrough; fleet them as observers of
            # the node's full allocation.
            observers.extend(
                (pod, container_name)
                for container_name in privileged_containers(pod)
                if all_phases or container_is_running(pod, container_name)
            )
            continue
        for container in containers:
            if not all_phases and not container_is_running(pod, container["name"]):
                continue
            rows.append(fleet_row(pod, container["name"], container["gpus"]))
    rows.extend(
        fleet_row(pod, container_name, gpus)
        for pod, container_name, gpus in observer_rows(ctx, observers)
    )
    return sorted(rows, key=lambda row: (row["namespace"], row["name"], row["container"]))


def cmd_fleet(args: argparse.Namespace) -> None:
    """List the GPU containers you own — the fleet.

    Kubernetes is the authority for fleet membership; .rexec*.yaml files are
    sync plumbing and deliberately play no part here (see dotfiles ADR 0001).
    Privileged containers with no nvidia.com/gpu request (dev pods using device
    passthrough) count as observers of their node's full GPU allocation.
    """
    ctx = base_context(args)
    owner = args.owner or os.environ.get("FLEET_USER") or os.environ.get("USER", "")
    if not owner:
        raise CommandError("Cannot determine owner: pass --owner or set FLEET_USER/USER")
    namespaces = [args.namespace] if args.namespace else list(DEFAULT_FLEET_NAMESPACES)
    pods = owned_pods(ctx, namespaces, owner, args.all_phases)
    if ctx["json"]:
        print(
            json.dumps(
                {
                    "owner": owner,
                    "context": ctx["context"],
                    "namespaces": namespaces,
                    "kubeconfig": ctx["kubeconfig"],
                    "pods": pods,
                },
                indent=2,
            )
        )
        return
    if not pods:
        print(f"No pods owned by {owner!r} in namespaces {', '.join(namespaces)}")
        return
    for pod in pods:
        print(
            f"{pod['namespace']}/{pod['name']}[{pod['container']}]\t"
            f"{pod['phase']}\t{pod['ready']}\t{pod['gpus']} GPU\t{pod['node']}"
        )


def add_common_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--context", help="Kubernetes context; defaults to the current context")
    parser.add_argument("--namespace", help="Restrict fleet discovery to one namespace")
    parser.add_argument("--json", action="store_true", help="Print JSON output")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Baseten GPU fleet query using an rcli Kubernetes context"
    )
    add_common_args(parser)
    subparsers = parser.add_subparsers(dest="command", required=True)

    fleet = subparsers.add_parser("fleet", help="List pods you own (the fleet)")
    fleet.add_argument("--owner", help="Owner identity token; defaults to $FLEET_USER then $USER")
    fleet.add_argument("--all-phases", action="store_true", help="Include non-Running pods")
    fleet.set_defaults(func=cmd_fleet)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    try:
        args.func(args)
    except KeyboardInterrupt:
        eprint("Interrupted")
        raise SystemExit(130)
    except CommandError as exc:
        eprint(f"error: {exc}")
        raise SystemExit(1)


if __name__ == "__main__":
    main()
