#!/bin/bash
# Claude Code notification hook (Stop, and PreToolUse for AskUserQuestion):
# post a macOS notification with click-to-focus of the zellij pane running
# this Claude Code instance, unless that pane is already in view.
# Receives hook JSON on stdin; zellij coordinates come from this process's
# environment (the hook runs inside the pane's process tree).
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

input=$(cat)
session_id=$(echo "$input" | jq -r '.session_id // "claude"')
cwd=$(echo "$input" | jq -r '.cwd // ""')
event=$(echo "$input" | jq -r '.hook_event_name // "Stop"')

# Quiet if the user is already looking at this pane.
if [ -n "${ZELLIJ_PANE_ID:-}" ] && [ -n "${ZELLIJ_SESSION_NAME:-}" ] &&
  "$HOME/.local/bin/zellij-pane-is-focused" "$ZELLIJ_SESSION_NAME" "terminal_$ZELLIJ_PANE_ID"; then
  exit 0
fi

pane_message() {
  # Pane title (Claude Code sets it to the session topic); fall back to the
  # working-directory basename.
  if [ -n "${ZELLIJ_PANE_ID:-}" ] && [ -n "${ZELLIJ_SESSION_NAME:-}" ]; then
    local pane_title
    pane_title=$(zellij --session "$ZELLIJ_SESSION_NAME" action list-panes --json 2>/dev/null |
      jq -r --argjson id "$ZELLIJ_PANE_ID" \
        '.[] | select(.is_plugin == false and .id == $id) | .title // empty')
    if [ -n "$pane_title" ]; then
      echo "$pane_title"
      return
    fi
  fi
  basename "${cwd:-$PWD}"
}

case "$event" in
PreToolUse)
  title="Claude Code — question"
  message=$(echo "$input" | jq -r '.tool_input.questions[0].question // empty')
  [ -n "$message" ] || message=$(pane_message)
  ;;
*)
  title="Claude Code — turn finished"
  message=$(pane_message)
  ;;
esac

args=(-group "claude-$session_id" -title "$title" -message "$message" -sound Glass)
if [ -n "${ZELLIJ_PANE_ID:-}" ] && [ -n "${ZELLIJ_SESSION_NAME:-}" ]; then
  args+=(-execute "'$HOME/.local/bin/zellij-focus-pane' '$ZELLIJ_SESSION_NAME' 'terminal_$ZELLIJ_PANE_ID'")
fi
/opt/homebrew/bin/terminal-notifier "${args[@]}" >/dev/null 2>&1 || true
