#!/bin/zsh

set -euo pipefail
umask 077

readonly package="@opencode/cli"
readonly channel="latest"
readonly root="$HOME/.local/share/opencode2"
readonly versions_dir="$root/versions"
readonly current_link="$root/current"
readonly lock_dir="$root/update.lock"
readonly log_dir="$HOME/Library/Logs"
readonly log_file="$log_dir/opencode-update.log"
readonly service="gui/$UID/ai.opencode.web"
readonly patch_builder="${0:A:h}/opencode-patch-build"

restart_mode="changed"
case "${1:-}" in
  "") ;;
  --no-restart) restart_mode="never" ;;
  --restart) restart_mode="always" ;;
  *)
    print -u2 "usage: opencode-update [--no-restart|--restart]"
    exit 2
    ;;
esac
(( $# <= 1 )) || {
  print -u2 "usage: opencode-update [--no-restart|--restart]"
  exit 2
}

mkdir -p "$versions_dir" "$log_dir"

log() {
  local line="$(date '+%F %T') $*"
  print -r -- "$line"
  print -r -- "$line" >>"$log_file"
}

if ! mkdir "$lock_dir" 2>/dev/null; then
  log "OpenCode update skipped: another update is running"
  exit 0
fi

install_dir=""
cleanup() {
  if [[ -n "$install_dir" && -d "$install_dir" ]]; then
    rm -rf "$install_dir"
  fi
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT

activate() {
  local target="$1"
  local pending_link="$root/.current.$$"

  rm -f "$pending_link"
  ln -s "$target" "$pending_link"
  /bin/mv -fh "$pending_link" "$current_link"
}

binary_version() {
  local value

  value="$("$1" --version 2>/dev/null || true)"
  value="${value##* }"
  print -r -- "${value#v}"
}

wait_for_health() {
  local expected_version="$1"
  local attempt code response

  for attempt in {1..30}; do
    code=$(
      /usr/bin/curl \
        --silent \
        --output /dev/null \
        --write-out '%{http_code}' \
        http://127.0.0.1:4096/api/status || true
    )
    if [[ "$code" == "401" ]]; then
      response="$("$HOME/.local/bin/opencode" api get /api/status 2>>"$log_file" ||
        "$HOME/.local/bin/opencode" api get /api/health 2>>"$log_file")" &&
        "$node_bin" -e '
          const status = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
          process.exit(status.version === process.argv[1] && status.pid > 0 ? 0 : 1);
        ' "$expected_version" <<<"$response" && return 0
    fi
    sleep 1
  done
  return 1
}

started_at=$(date +%s)
log "OpenCode update started"

npm_bin="$(command -v npm)" || {
  log "OpenCode update failed: npm is not available on PATH"
  exit 1
}
node_bin="$(command -v node)" || {
  log "OpenCode update failed: node is not available on PATH"
  exit 1
}

release_selector="$channel"
if [[ -f "$root/pinned-version" ]]; then
  release_selector="$(<"$root/pinned-version")"
  [[ "$release_selector" =~ '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' ]] || {
    log "OpenCode update failed: pinned-version must contain an exact version"
    exit 1
  }
fi
latest="$("$npm_bin" view "$package@$release_selector" version --silent)"
[[ "$latest" =~ '^[0-9A-Za-z][0-9A-Za-z._-]*$' ]] || {
  log "OpenCode update failed: npm returned an invalid version"
  exit 1
}

previous_target="$(readlink "$current_link" 2>/dev/null || true)"
[[ "$previous_target" == versions/* ]] || previous_target=""
current_version=""
if [[ -x "$current_link/bin/opencode2" ]]; then
  current_version="$(binary_version "$current_link/bin/opencode2")"
fi
log "Resolved $package@$release_selector to $latest"

official_dir="$versions_dir/$latest"
if [[ ! -x "$official_dir/bin/opencode2" ]]; then
  install_dir="$versions_dir/.install-$latest-$$"
  log "Installing OpenCode $latest"
  if ! "$npm_bin" install \
    --global \
    --prefix "$install_dir" \
    --no-audit \
    --no-fund \
    --ignore-scripts \
    "$package@$latest" >>"$log_file" 2>&1; then
    log "OpenCode update failed while installing $latest"
    exit 1
  fi

  if ! "$node_bin" \
    "$install_dir/lib/node_modules/$package/postinstall.mjs" \
    >>"$log_file" 2>&1; then
    log "OpenCode update failed while preparing the platform binary"
    exit 1
  fi

  installed_version="$(binary_version "$install_dir/bin/opencode2")"
  [[ "$installed_version" == "$latest" ]] || {
    log "OpenCode update failed: installed version ${installed_version:-missing} did not match $latest"
    exit 1
  }

  rm -rf "$official_dir"
  /bin/mv "$install_dir" "$official_dir"
  install_dir=""
fi

desired_version="$latest"
if [[ -x "$patch_builder" ]]; then
  if patched_version="$("$patch_builder" "$latest" 2>>"$log_file")"; then
    if [[ "$patched_version" =~ '^[0-9A-Za-z][0-9A-Za-z._-]*$' ]] && \
      [[ -x "$versions_dir/$patched_version/bin/opencode2" ]] && \
      [[ "$(binary_version "$versions_dir/$patched_version/bin/opencode2")" == "$patched_version" ]]; then
      desired_version="$patched_version"
    else
      log "Patch builder returned an invalid artifact; using official OpenCode $latest"
    fi
  else
    log "Throughput patch build failed; using official OpenCode $latest (details in $log_file)"
  fi
fi

changed=false
version_dir="$versions_dir/$desired_version"
if [[ "$current_version" != "$desired_version" ]]; then
  changed=true
  activate "versions/$desired_version"
  log "Activated OpenCode $desired_version"
else
  log "OpenCode $desired_version is already current"
fi

restart=false
if [[ "$restart_mode" == "always" ]]; then
  restart=true
elif [[ "$restart_mode" == "changed" && "$changed" == true ]]; then
  restart=true
fi

if [[ "$restart" == true ]] && launchctl print "$service" >/dev/null 2>&1; then
  log "Restarting the OpenCode server"
  healthy=false
  if "$HOME/.local/bin/opencode" service restart >/dev/null && wait_for_health "$desired_version"; then
    healthy=true
  elif [[ "$desired_version" != "$latest" ]]; then
    log "Patched OpenCode failed health checks; trying official OpenCode $latest"
    mkdir -p "$root/patch-failures"
    touch "$root/patch-failures/$desired_version"
    activate "versions/$latest"
    desired_version="$latest"
    version_dir="$official_dir"
    if "$HOME/.local/bin/opencode" service restart >/dev/null && wait_for_health "$desired_version"; then
      healthy=true
    fi
  fi
  if [[ "$healthy" != true ]]; then
    if [[ -n "$previous_target" && -x "$root/$previous_target/bin/opencode2" ]]; then
      log "OpenCode $latest failed health checks; rolling back"
      activate "$previous_target"
      if ! "$HOME/.local/bin/opencode" service restart >/dev/null || ! wait_for_health "$current_version"; then
        log "OpenCode rollback failed health checks"
      fi
    else
      log "OpenCode $latest failed health checks and no rollback is available"
    fi
    exit 1
  fi
  log "OpenCode server is healthy"
elif [[ "$changed" == true ]]; then
  log "OpenCode $desired_version is staged for the next server start"
fi

previous_dir=""
if [[ -n "$previous_target" ]]; then
  previous_dir="$root/$previous_target"
fi
for directory in "$versions_dir"/*(N/); do
  [[ "$directory" == "$version_dir" || "$directory" == "$previous_dir" || "$directory" == "$official_dir" ]] && continue
  rm -rf "$directory"
done

finished_at=$(date +%s)
log "OpenCode update completed in $(( finished_at - started_at ))s"
