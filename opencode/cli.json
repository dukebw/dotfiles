{
  "keybinds": {
    "leader": "ctrl+x",
    "session.timeline": "<leader>shift+t",
    "session.parent": "<leader>p",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.first": "<leader>g",
    "session.last": "<leader>shift+g"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "enabled": false
  },
  "animations": true
}
