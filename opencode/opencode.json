  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 60000
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": { "model": "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast#max" },
    "explore": { "model": "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast#max" },
    "general": { "model": "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast#max" }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "websearch": {
    "provider": "random"
  },
  "plugins": [
    "opencode-muse-code",
    "@openchamber/opencode-claude"
  ]
}
