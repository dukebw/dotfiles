{
  "model": "openai/gpt-6-astra-fast",
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./plugins/notify.ts"],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "servers": {
      "honeycomb": {
        "type": "remote",
        "url": "https://mcp.honeycomb.io/mcp"
      }
    }
  },
  "providers": {
    "baseten": {
      "models": {
        "moonshotai/Kimi-K3": {
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 131072
          }
        }
      }
    },
    "inco": {
      "name": "Inco",
      "env": ["INCO_API_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.inco.ai/v1"
      },
      "models": {
        "kimi-k3:fast": {
          "name": "Kimi K3 Fast",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "body": {
            "reasoning_effort": "max"
          },
          "variants": [
            {
              "id": "low",
              "body": { "reasoning_effort": "low" }
            },
            {
              "id": "high",
              "body": { "reasoning_effort": "high" }
            },
            {
              "id": "max",
              "body": { "reasoning_effort": "max" }
            }
          ]
        }
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6-astra-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "family": "gpt-astra",
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-5.4": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.3-codex": {
          "options": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.5-fast": {
          "options": {
            "reasoningSummary": "detailed"
          }
        },
        "gpt-5.6-sol-fast": {
          "options": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 1050000,
            "input": 900000,
            "output": 128000
          },
          "variants": {
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 60000
    }
  },
  "permission": "allow",
  "agents": {
    "build": {
      "model": "openai/gpt-6-astra-fast#max"
    },
    "explore": { "model": "openai/gpt-6-astra-fast#high" },
    "general": { "model": "openai/gpt-6-astra-fast#high" }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "websearch": {
    "provider": "random"
  }
}
