{
  "model": "openai/gpt-5.6-sol-fast",
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./plugins/notify.ts"],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.3-codex": {
          "options": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.5-fast": {
          "options": {
            "reasoningSummary": "detailed"
          }
        },
        "gpt-5.6-sol-fast": {
          "options": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "max"
          },
          "variants": {
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 16000
  },
  "permission": "allow",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol-fast",
      "variant": "max"
    },
    "explore": { "model": "openai/gpt-5.6-sol-fast", "reasoningEffort": "high" },
    "scout": { "model": "openai/gpt-5.6-sol-fast", "reasoningEffort": "high" },
    "general": { "model": "openai/gpt-5.6-sol-fast", "reasoningEffort": "high" }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
