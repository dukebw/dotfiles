{
  "model": "openai/gpt-6-astra",
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["/Users/brendanduke/work/opencode-request-recorder"],
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": {},
        "disabled": false
      },
      "honeycomb": {
        "type": "remote",
        "url": "https://mcp.honeycomb.io/mcp"
      }
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-astra-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "family": "gpt-astra",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.4": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.3-codex": {
          "settings": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.5-fast": {
          "settings": {
            "reasoningSummary": "detailed"
          }
        },
        "gpt-5.6-sol-fast": {
          "settings": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 1050000,
            "input": 900000,
            "output": 128000
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "auto",
                "include": ["reasoning.encrypted_content"]
              }
            }
          ]
        }
      }
    },
    "baseten": {
      "models": {
        "moonshotai/Kimi-K3": {
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 131072
          }
        },
        "deepseek-ai/DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash",
          "family": "deepseek-flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
    "inco": {
      "name": "Inco",
      "env": ["INCO_API_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.inco.ai/v1"
      },
      "models": {
        "kimi-k3:fast": {
          "name": "Kimi K3 Fast",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "body": {
            "reasoning_effort": "max"
          },
          "variants": [
            {
              "id": "low",
              "body": { "reasoning_effort": "low" }
            },
            {
              "id": "high",
              "body": { "reasoning_effort": "high" }
            },
            {
              "id": "max",
              "body": { "reasoning_effort": "max" }
            }
          ]
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 60000
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "model": "openai/gpt-6-astra#xhigh"
    },
    "explore": { "model": "openai/gpt-6-astra#high" },
    "general": { "model": "openai/gpt-6-astra#high" }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "websearch": {
    "provider": "random"
  }
}
