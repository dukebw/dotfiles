{
  "model": "openai/gpt-5.5-fast",
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "grafana": {
      "type": "local",
      "command": ["pipx", "run", "mcp-grafana"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "GRAFANA_URL": "https://grafana.baseten.co",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}",
        "GRAFANA_ORG_ID": "1"
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.3-codex": {
          "options": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.5-fast": {
          "options": {
            "reasoningSummary": "detailed"
          }
        }
      }
    },
    "google": {
      "models": {
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview (customtools)"
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview"
        }
      },
      "options": {
        "timeout": 600000
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "permission": "allow",
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  }
}
