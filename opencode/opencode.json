{
  "model": "openai/gpt-6.1-sol",
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": {},
        "disabled": false
      },
      "honeycomb": {
        "type": "remote",
        "url": "https://mcp.honeycomb.io/mcp"
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=xpxgrxzjjxjfmvdkqosx&features=database"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": false
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "disabled": false,
        "oauth": {
          "client_id": "549215267044.12328925678677",
          "redirect_uri": "http://127.0.0.1:19876/mcp/oauth/callback",
          "scope": "search:read.public search:read.private search:read.mpim search:read.im search:read.files search:read.users channels:history groups:history mpim:history im:history canvases:read users:read users:read.email reactions:read emoji:read files:read channels:read groups:read mpim:read"
        }
      },
      "baseten": {
        "type": "remote",
        "url": "http://127.0.0.1:4202/mcp",
        "disabled": true,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "baseten-internal-mcp": {
        "type": "remote",
        "url": "https://baseten.runlayer.com/api/v1/proxy/3a93ef17-f7c5-4262-b554-6d8bdecca086/mcp",
        "oauth": {},
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "coros": {
        "type": "local",
        "command": [
          "/bin/zsh",
          "-lc",
          "exec opencode-mcp-remote https://mcpus.coros.com/mcp"
        ],
        "disabled": false,
        "timeout": {
          "startup": 60000,
          "catalog": 30000,
          "execution": 30000
        }
      },
      "grafana": {
        "type": "local",
        "command": ["pipx", "run", "mcp-grafana"],
        "disabled": true,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        },
        "environment": {
          "GRAFANA_URL": "https://grafana.baseten.co",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}",
          "GRAFANA_ORG_ID": "1"
        }
      }
    }
  },
  "providers": {
    "k3f": {
      "name": "Kimi K3 Flash (dev BIS stack)",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "env": ["K3F_API_KEY"],
      "settings": {
        "baseURL": "http://127.0.0.1:18000/v1"
      },
      "options": {},
      "models": {
        "moonshotai/Kimi-K3-Flash": {
          "name": "Kimi K3 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 49152
          },
          "body": {
            "reasoning_effort": "max"
          },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "high", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "xhigh",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-6.1-sol-fast": {
          "settings": {
            "reasoningEffort": "xhigh",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-6-astra-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "family": "gpt-astra",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-5.4": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.3-codex": {
          "settings": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.5-fast": {
          "settings": {
            "reasoningSummary": "detailed"
          }
        },
        "gpt-5.6-sol-fast": {
          "settings": {
            "reasoningSummary": "detailed",
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 1050000,
            "input": 900000,
            "output": 128000
          },
          "variants": [
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "auto",
                "include": ["reasoning.encrypted_content"]
              }
            }
          ]
        }
      }
    },
    "kimi": {
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["KIMI_API_KEY"],
      "settings": {
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{env:KIMI_API_KEY}"
      },
      "models": {
        "kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro",
          "family": "kimi-k3",
          "releaseDate": "2026-10-23",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 1048576
          },
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.2,
            "cache_write": 2
          },
          "body": {
            "reasoning_effort": "max"
          },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "high", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "kimi-k3.1-pro-highspeed": {
          "name": "Kimi K3.1 Pro Highspeed",
          "family": "kimi-k3",
          "releaseDate": "2026-10-23",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 1048576
          },
          "cost": {
            "input": 4,
            "output": 20,
            "cache_read": 0.2,
            "cache_write": 4
          },
          "body": {
            "reasoning_effort": "max"
          },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "high", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        }
      }
    },
    "baseten": {
      "models": {
        "moonshotai/Kimi-K3": {
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 131072
          },
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "deepseek-ai/DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash",
          "family": "deepseek-flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "family": "deepseek-flash",
          "capabilities": {
            "tools": true,
