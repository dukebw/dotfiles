#!/usr/bin/env python3
"""rexec - Remote Execution Tool

IMPORTANT FOR AI ASSISTANTS (Claude, Codex, Kimi, etc.):
This script executes commands on a REMOTE SERVER via SSH, NOT locally.
Commands run on a Coder workspace with files synced via Mutagen.

Usage:
    rexec <command> [args...]         # Run command remotely (argv mode)
    rexec --shell "cmd | pipe"        # Run shell string remotely
    rexec --flush <command>           # Flush Mutagen before running
    rexec --tty <command>             # Allocate TTY (for interactive)
    rexec -q <command>                # Quiet mode (no header)

Examples:
    rexec ./bazelw build //path:target
    rexec --shell "ls -la | head -5"
    rexec --flush ./bazelw test //...
    rexec --tty htop
"""

import argparse
import shlex
import subprocess
import sys
from pathlib import Path

# Colors (stderr only)
RED = "\033[0;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
BLUE = "\033[0;34m"
CYAN = "\033[0;36m"
BOLD = "\033[1m"
DIM = "\033[2m"
NC = "\033[0m"

# Configuration
DEFAULT_REMOTE = "b200-hydra.coder"
DEFAULT_WORKDIR = "/home/ubuntu/work/modular"

# Optional explicit worktree overrides (host, workdir).
# Most setups should rely on automatic mutagen.yml detection instead.
WORKTREE_MAPPINGS: dict[Path, tuple[str, str] | str] = {}


def eprint(*args, **kwargs):
    """Print to stderr."""
    print(*args, file=sys.stderr, **kwargs)


def get_local_git_info() -> str:
    """Get local git commit for header."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, check=True
        )
        return result.stdout.strip()
    except Exception:
        return "unknown"


def detect_remote_from_cwd() -> tuple[str, str]:
    """Detect the remote host/workdir based on the current working directory."""
    cwd = Path.cwd()
    for path in [cwd] + list(cwd.parents):
        if path in WORKTREE_MAPPINGS:
            mapping = WORKTREE_MAPPINGS[path]
            if isinstance(mapping, tuple):
                return mapping
            return mapping, DEFAULT_WORKDIR

        mutagen_mapping = _detect_remote_from_mutagen_config(path)
        if mutagen_mapping is not None:
            return mutagen_mapping

    return DEFAULT_REMOTE, DEFAULT_WORKDIR


def normalize_host(host: str) -> str:
    """Ensure host has .coder suffix."""
    if not host.endswith(".coder"):
        return f"{host}.coder"
    return host


def _parse_yaml_scalar(raw_value: str) -> str:
    """Parse a simple YAML scalar value from an inline key/value pair."""
    value = raw_value.strip()
    if value and value[0] in ('"', "'") and value[-1] == value[0]:
        return value[1:-1]
    return value


def _parse_mutagen_beta(beta: str) -> tuple[str, str] | None:
    """Parse mutagen beta endpoint like host:/absolute/path."""
    if ":" not in beta:
        return None

    host, workdir = beta.split(":", 1)
    host = host.strip()
    workdir = workdir.strip()
    if not host or not workdir:
        return None

    if not (workdir.startswith("/") or workdir.startswith("~")):
        return None

    return normalize_host(host), workdir


def _detect_remote_from_mutagen_config(path: Path) -> tuple[str, str] | None:
    """Detect host/workdir by reading mutagen.yml in the current tree."""
    config_path = path / "mutagen.yml"
    if not config_path.exists():
        return None

    try:
        lines = config_path.read_text().splitlines()
    except OSError:
        return None

    in_sync = False
    current_session: str | None = None
    sessions: dict[str, dict[str, str]] = {}

    for raw_line in lines:
        line = raw_line.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue

        indent = len(line) - len(line.lstrip(" "))
        stripped = line.strip()

        if not in_sync:
            if indent == 0 and stripped == "sync:":
                in_sync = True
            continue

        if indent == 0:
            break

        if indent == 2 and stripped.endswith(":"):
            section = stripped[:-1].strip()
            current_session = None if section == "defaults" else section
            if current_session is not None:
                sessions.setdefault(current_session, {})
            continue

        if current_session is None:
            continue

        if indent == 4 and ":" in stripped:
            key, raw_value = stripped.split(":", 1)
            key = key.strip()
            if key not in {"alpha", "beta"}:
                continue
            value = _parse_yaml_scalar(raw_value)
            if value:
                sessions[current_session][key] = value

    try:
        repo_root = path.resolve()
    except OSError:
        repo_root = path

    for session in sessions.values():
        alpha = session.get("alpha")
        beta = session.get("beta")
        if not alpha or not beta:
            continue

        alpha_path = Path(alpha).expanduser()
        try:
            alpha_path = alpha_path.resolve()
        except OSError:
            pass

        if alpha_path != repo_root:
            continue

        parsed_beta = _parse_mutagen_beta(beta)
        if parsed_beta is not None:
            return parsed_beta

    # If there is exactly one sync session, use it even without matching alpha.
    if len(sessions) == 1:
        only_session = next(iter(sessions.values()))
        beta = only_session.get("beta")
        if beta:
            return _parse_mutagen_beta(beta)

    return None


def _find_mutagen_root() -> Path:
    cwd = Path.cwd()
    for path in [cwd] + list(cwd.parents):
        if (path / "mutagen.yml").exists():
            return path
    return Path.home() / "work" / "modular"


def flush_mutagen() -> bool:
    """Flush Mutagen project sync."""
    eprint(f"{BLUE}Flushing Mutagen...{NC}", end=" ")
    result = subprocess.run(
        ["mutagen", "project", "flush"],
        capture_output=True,
        cwd=_find_mutagen_root(),
    )
    if result.returncode == 0:
        eprint(f"{GREEN}done{NC}")
        return True
    else:
        # Try session-based flush as fallback
        result = subprocess.run(
            ["mutagen", "sync", "flush", "modular-hydra"],
            capture_output=True,
        )
        if result.returncode == 0:
            eprint(f"{GREEN}done{NC}")
            return True
        eprint(f"{YELLOW}skipped{NC}")
        return False


def print_header(host: str, workdir: str, command: str) -> None:
    """Print a clear header indicating remote execution (to stderr)."""
    commit = get_local_git_info()
    eprint(f"{BOLD}╔══════════════════════════════════════════════════════════════╗{NC}")
    eprint(f"{BOLD}║{NC} {CYAN}REMOTE EXECUTION{NC}                                             {BOLD}║{NC}")
    eprint(f"{BOLD}╠══════════════════════════════════════════════════════════════╣{NC}")
    eprint(f"{BOLD}║{NC} Host:    {GREEN}{host}{NC}")
    eprint(f"{BOLD}║{NC} Workdir: {BLUE}{workdir}{NC}")
    eprint(f"{BOLD}║{NC} Commit:  {DIM}{commit}{NC} (local)")
    eprint(f"{BOLD}║{NC} Command: {YELLOW}{command}{NC}")
    eprint(f"{BOLD}╚══════════════════════════════════════════════════════════════╝{NC}")
    eprint()


def execute(host: str, workdir: str, command: list[str], shell_mode: bool = False,
            tty: bool = False, quiet: bool = False) -> int:
    """Execute a command on the remote host."""
    # Build the command string
    if shell_mode:
        # Shell mode: wrap in non-login bash to avoid profile banners.
        cmd_str = command[0] if len(command) == 1 else " ".join(command)
        remote_cmd = f"cd {workdir} && bash -c {shlex.quote(cmd_str)}"
    else:
        # Argv mode: proper escaping
        cmd_str = " ".join(shlex.quote(arg) for arg in command)
        remote_cmd = f"cd {workdir} && {cmd_str}"

    if not quiet:
        print_header(host, workdir, cmd_str)

    # Build SSH command (multiplexing handled by ~/.ssh/config)
    ssh_cmd = [
        "ssh",
        "-o",
        "SetEnv=LANG=C.UTF-8 LC_ALL=C.UTF-8",
    ]
    # Auto-allocate a PTY only for fully interactive use so Ctrl+C propagates
    # as SIGINT to the remote process. When stdout/stderr are piped (for
    # example via `r`'s tee-to-log wrapper), skip the PTY so the log captures
    # plain text instead of terminal control sequences.
    if tty or (sys.stdin.isatty() and sys.stdout.isatty() and sys.stderr.isatty()):
        ssh_cmd.append("-t")
    ssh_cmd.extend([host, remote_cmd])

    # Execute
    result = subprocess.run(ssh_cmd)
    return result.returncode


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Execute commands on a remote Coder workspace via SSH.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    rexec ./bazelw build //path:target     # Argv mode (safe escaping)
    rexec --shell "ls | head -5"           # Shell mode (pipes work)
    rexec --flush ./bazelw test //...      # Flush sync first
    rexec --tty htop                       # Interactive (allocate TTY)
    rexec -q hostname                      # Quiet (no header)
        """,
    )

    parser.add_argument("command", nargs=argparse.REMAINDER, help="Command to execute")
    parser.add_argument("--remote", "-r", help="Remote host (default: auto-detect)")
    parser.add_argument("--shell", "-s", action="store_true",
                        help="Shell mode: run as bash -lc 'command'")
    parser.add_argument("--tty", "-t", action="store_true",
                        help="Allocate TTY (for interactive commands)")
    parser.add_argument("--flush", "-f", action="store_true",
                        help="Flush Mutagen sync before executing")
    parser.add_argument("--quiet", "-q", action="store_true",
                        help="Suppress header output")

    args = parser.parse_args()

    # Determine the remote host
    host, workdir = detect_remote_from_cwd()
    if args.remote:
        host = normalize_host(args.remote)

    # Require a command
    if not args.command:
        parser.print_help()
        sys.exit(1)

    # Flush if requested
    if args.flush:
        flush_mutagen()

    # Execute the command
    sys.exit(execute(host, workdir, args.command, args.shell, args.tty, args.quiet))


if __name__ == "__main__":
    main()
