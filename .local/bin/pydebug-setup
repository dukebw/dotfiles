#!/usr/bin/env python3
"""pydebug-setup: Set up Python debug environment for any Bazel target.

Uses fzf for interactive target selection, runs via rexec by default.
"""

import argparse
import re
import subprocess
import sys
import time
from pathlib import Path

# Colors
RED = "\033[0;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
BLUE = "\033[0;34m"
NC = "\033[0m"  # No Color

CACHE_DIR = Path.home() / ".cache" / "pydebug-setup"
CACHE_FILE = CACHE_DIR / "targets.txt"
CACHE_MAX_AGE = 3600  # 1 hour in seconds


def print_color(color: str, msg: str, end: str = "\n") -> None:
    print(f"{color}{msg}{NC}", end=end)


def run_cmd(cmd: str, use_rexec: bool, dry_run: bool) -> int:
    """Run a command, optionally via rexec."""
    if dry_run:
        prefix = "rexec --shell " if use_rexec else ""
        print_color(YELLOW, f"[dry-run] {prefix}{cmd}")
        return 0

    if use_rexec:
        print(f"{BLUE}→{NC} rexec --shell {cmd}")
        result = subprocess.run(["rexec", "--shell", cmd], check=False)
    else:
        print(f"{BLUE}→{NC} {cmd}")
        result = subprocess.run(cmd, shell=True, check=False)

    return result.returncode


def cache_is_valid() -> bool:
    """Check if the cache file exists and is less than CACHE_MAX_AGE old."""
    if not CACHE_FILE.exists():
        return False
    age = time.time() - CACHE_FILE.stat().st_mtime
    return age < CACHE_MAX_AGE


def refresh_cache(use_rexec: bool) -> None:
    """Query Bazel for Python targets and cache the results."""
    print_color(BLUE, "Querying Bazel for Python targets...")
    CACHE_DIR.mkdir(parents=True, exist_ok=True)

    query = 'kind("py_binary|py_test", //...)'

    if use_rexec:
        result = subprocess.run(
            ["rexec", "-q", "--shell", f"./bazelw query '{query}' 2>/dev/null"],
            capture_output=True,
            text=True,
            check=False,
        )
    else:
        result = subprocess.run(
            f"./bazelw query '{query}' 2>/dev/null",
            shell=True,
            capture_output=True,
            text=True,
            check=False,
        )

    targets = result.stdout.strip()
    CACHE_FILE.write_text(targets)

    count = len(targets.splitlines()) if targets else 0
    print_color(GREEN, f"Cached {count} targets")


def get_targets(use_rexec: bool, refresh: bool) -> list[str]:
    """Get list of Python targets, using cache if valid."""
    if refresh or not cache_is_valid():
        refresh_cache(use_rexec)

    if not CACHE_FILE.exists():
        return []

    return CACHE_FILE.read_text().strip().splitlines()


def format_target_for_fzf(target: str) -> str:
    """Add colored prefix based on target type."""
    if "_test" in target or "test" in target.split(":")[-1]:
        return f"\033[33m[test]\033[0m {target}"
    return f"\033[32m[bin]\033[0m  {target}"


def select_target_with_fzf(targets: list[str]) -> str | None:
    """Use fzf to select a target interactively."""
    if not targets:
        print_color(RED, "No targets found")
        return None

    # Format targets for fzf
    formatted = "\n".join(format_target_for_fzf(t) for t in targets)

    try:
        result = subprocess.run(
            ["fzf", "--ansi", "--prompt=Select Python target: ", "--height=40%", "--reverse"],
            input=formatted,
            capture_output=True,
            text=True,
            check=True,
        )
        # Strip the [bin]/[test] prefix
        selected = result.stdout.strip()
        # Remove ANSI codes and prefix
        clean = re.sub(r"\033\[[0-9;]*m", "", selected)
        clean = re.sub(r"^\[(bin|test)\]\s*", "", clean)
        return clean
    except subprocess.CalledProcessError:
        return None  # User cancelled fzf
    except FileNotFoundError:
        print_color(RED, "fzf not found. Install with: brew install fzf")
        sys.exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Set up Python debug environment for a Bazel target.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    pydebug-setup                              # Interactive fzf selection
    pydebug-setup //max/python/max/entrypoints:pipelines
    pydebug-setup -r                           # Refresh cache, then select
    pydebug-setup -l //path:target             # Run locally
        """,
    )
    parser.add_argument("target", nargs="?", help="Bazel target (e.g., //path:target)")
    parser.add_argument("-r", "--refresh", action="store_true", help="Refresh the target cache")
    parser.add_argument("-l", "--local", action="store_true", help="Run locally instead of via rexec")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Show commands without executing")

    args = parser.parse_args()

    use_rexec = not args.local
    target = args.target

    # Select target if not provided
    if not target:
        targets = get_targets(use_rexec, args.refresh)
        target = select_target_with_fzf(targets)
        if not target:
            print_color(RED, "No target selected")
            sys.exit(1)

    print_color(GREEN, f"Setting up debug environment for: {NC}{target}")
    print()

    # Build the venv target
    venv_target = f"{target}.venv"
    print_color(BLUE, "Step 1: ", end="")
    print("Creating venv...")
    ret = run_cmd(f"./bazelw run {venv_target}", use_rexec, args.dry_run)
    if ret != 0:
        print_color(RED, f"Failed to create venv (exit code {ret})")
        sys.exit(1)

    # Install debugpy
    print()
    print_color(BLUE, "Step 2: ", end="")
    print("Installing debugpy...")
    ret = run_cmd(".venv/bin/pip install debugpy", use_rexec, args.dry_run)
    if ret != 0:
        print_color(RED, f"Failed to install debugpy (exit code {ret})")
        sys.exit(1)

    # Success message
    print()
    print_color(GREEN, "✓ Debug environment ready!")
    print()
    print("To debug, add this to your Python file:")
    print_color(YELLOW, "    import debugpy")
    print_color(YELLOW, "    debugpy.listen(5678)")
    print_color(YELLOW, "    debugpy.wait_for_client()")
    print()
    print(f"Or use nvim-dap with {BLUE}<leader>ec{NC} to start debugging.")


if __name__ == "__main__":
    main()
